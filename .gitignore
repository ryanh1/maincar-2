# Dependencies
# No trailing slash on these two: mc-clone reuses the primary checkout's
# dependency tree via a `node_modules` SYMLINK, and a trailing-slash pattern
# only matches a real directory, not a symlink — so `node_modules/` alone
# left every issue clone's symlinks showing as untracked.
node_modules
**/node_modules
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (keep the .example files)
.env
.env.local
.env.production
.env.staging
.env.development
.env.old
.env.deploy.*

# Firebase emulator export/import + debug. The emulator replaces this directory
# with runtime snapshots, so no placeholder inside it may be tracked.
firebase/data/
firebase_key.json
firestore-debug.log
firebase-debug.log
firebase-export-*/

# Docker local volumes (this stack uses named volumes, but keep the guard)
docker/data/

# Prisma generated client
server/src/generated/

# Test/coverage
coverage/

.vercel
.gstack/
