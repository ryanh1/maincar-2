#!/usr/bin/env bash
#
# Static checks share the same three-job gate as development and delivery.
# This keeps many issue clones from overwhelming one computer.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
primary_checkout="${MC_MAIN_CHECKOUT:-$HOME/Documents/Coding/My Projects/maincar-2}"
if [ "$(pwd -P)" = "$(cd "$primary_checkout" && pwd -P)" ]; then
  echo ""
  echo "  ✗ COMMIT BLOCKED — the primary checkout is a reference, not a ticket workspace."
  echo "    Create an issue clone under ~/code/maincar-2-worktrees and commit there."
  echo ""
  exit 1
fi
./.claude/scripts/coord/mc-gate --static
printf 'green\n' > "$(git rev-parse --git-dir)/VERIFY_STATUS"
echo 'pre-commit: TypeScript and lint checks passed.'
