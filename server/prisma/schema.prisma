// The connection URL is NOT set here — it comes from prisma.config.ts, which
// reads the repo-root .env. That is the Prisma 7 style.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// House rules for every model in this file (CLAUDE.md → Database / Prisma):
//
//   1. EVERY model has `createdAt` and `updatedAt`. No exceptions.
//   2. NEVER use a Prisma `enum`. Use a String and document the allowed values in
//      a comment beside the field, with a matching TypeScript union in app code.
//      Postgres enums need an ALTER TYPE dance to add or remove a value; a String
//      column just changes.
//   3. Every org-scoped model carries `orgId` and is indexed on it. Reads AND
//      writes filter on it.
// -----------------------------------------------------------------------------

model Org {
  id        String   @id @default(cuid())
  name      String?
  logo      String?
  enabled   Boolean  @default(true)

  // Which version of the standard-schema seed (server/src/crm/standardObjects.ts)
  // this org has had applied. Set by seedOrg on org creation; a later release bumps
  // CURRENT_SEED_VERSION and the insert-missing-only backfill catches orgs behind
  // it (MAI-134 T6, spec §10.2). 0 = never seeded.
  seedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  phoneNumbers     PhoneNumber[]
  calls            Call[]
  emailDrafts      EmailDraft[]
  emailTemplates   EmailTemplate[]
  oauthConnections OAuthConnection[]
  mailAccounts     MailAccount[]

  // CRM spine (MAI-129 T1, MAI-130 T2). Back-relations so a deleted org cascades
  // its CRM rows away — the same onDelete: Cascade the dialer models already use.
  companies    Company[]
  people       Person[]
  personPhones PersonPhone[]
  personEmails PersonEmail[]

  // Deal spine (MAI-131 T3). Back-relations so a deleted org cascades its deals,
  // pipelines, stages, and per-deal roles away — the same onDelete: Cascade the
  // rest of the CRM spine already uses.
  pipelines       Pipeline[]
  pipelineStages  PipelineStage[]
  deals           Deal[]
  dealPersonRoles DealPersonRole[]

  // Schema-as-data (MAI-133 T5). Back-relations so a deleted org cascades its
  // object/attribute definitions away — the same onDelete: Cascade the rest of
  // the CRM spine already uses.
  objectDefs    ObjectDef[]
  attributeDefs AttributeDef[]
}

model User {
  id String @id @default(cuid())

  // The Firebase Auth uid. This is the join between the ID token on a request and
  // the row here; it is how `requireAuth` resolves a caller.
  firebaseUid String @unique

  email     String  @unique
  firstName String?
  lastName  String?
  title     String?
  imageUrl  String?

  // false blocks sign-in without deleting anything.
  enabled Boolean @default(true)

  // Global platform roles: basic, admin, superadmin. Per-org roles live in Membership.
  roles String[] @default(["basic"])

  // IANA timezone, e.g. "America/New_York". Captured at onboarding, defaulted
  // from the browser. Every time-of-day shown to this user renders in it
  // (CLAUDE.md → Dates & Times).
  timeZone String?

  // The org this user currently has selected (for UI context; not used for auth).
  // Nullable — the user may not have any org yet (edge case after account creation).
  currentOrgId String?

  memberships         Membership[]
  invitationsSent     Invitation[]      @relation("InvitationSender")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptor")
  phoneNumbers        PhoneNumber[]
  calls               Call[]
  emailDrafts         EmailDraft[]
  emailTemplates      EmailTemplate[]
  oauthConnections    OAuthConnection[]
  mailAccounts        MailAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentOrgId])
}

// Join table: users can belong to multiple orgs, each with their own role set.
model Membership {
  id String @id @default(cuid())

  userId String
  orgId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "owner", "admin", "basic". Per-org role set (different from
  // global roles). A String[] rather than an enum, per rule 2 in the schema
  // header. "owner" is never granted from the member list — ownership moves by
  // transfer — so it is absent from `assignableRolesSchema`.
  roles String[] @default(["basic"])

  // Offboarding flips this to false. The row stays so re-inviting the same person
  // reactivates it under @@unique([userId, orgId]) instead of colliding, and so a
  // departure is still visible in the record. EVERY membership read filters on it:
  // an inactive membership is the same as no membership.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([orgId, isActive])
}

// Member invitations to orgs.
model Invitation {
  id    String @id @default(cuid())
  token String @unique

  email String
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "PENDING", "ACCEPTED", "EXPIRED", "REVOKED"
  status String @default("PENDING")

  // Roles this invite grants (basic, admin, etc.)
  roles String[] @default(["basic"])

  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  invitedByUserId String?
  invitedByUser   User?   @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([email])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Dialer
//
// The dialer spec (docs/specs/SPEC-DIALER-REBUILD.md) calls the tenant key
// `workspaceId`. This schema has always called it `orgId` and points it at `Org`
// (CLAUDE.md → Database / Prisma: "Every org-scoped model carries orgId"). One
// name for one thing, so the dialer models use `orgId` too.
// -----------------------------------------------------------------------------

// A Twilio number an org owns and hands to one of its members. A user may hold
// several; at most one of theirs is the caller ID for outbound calls.
model PhoneNumber {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member this number belongs to. Restrict, not Cascade: releasing a number
  // is a Twilio call, not a row delete, so a user who still holds one cannot be
  // deleted out from under it.
  assignedUserId String
  assignedUser   User   @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)

  // E.164, e.g. "+12025550123".
  e164 String

  // Twilio's SID for the number. Null until the provisioning job has actually
  // bought it — the row is written first, with status "searching".
  twilioSid String?

  // Allowed values: "searching", "active", "releasing", "failed".
  status String @default("searching")

  // At most one true per user. Enforced in the route, in a transaction.
  isActiveForOutbound Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([assignedUserId])
  @@index([e164])
}

// One call, inbound or outbound, and everything learned about it afterwards.
model Call {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member who placed or received the call. Restrict so call history is
  // never destroyed as a side effect of deleting a user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // E.164 both sides. fromE164 is the caller ID actually used.
  fromE164 String
  toE164   String

  // Allowed values: "outbound", "inbound".
  direction String

  // Allowed values: "queued", "ringing", "in-progress", "completed", "busy",
  // "failed", "no-answer", "canceled".
  status String @default("queued")

  // Twilio's SID for the call. Null until Twilio accepts it. Unique so the
  // status and recording webhooks can look the row up by SID alone; Postgres
  // allows many NULLs under a unique index, so queued rows do not collide.
  twilioCallSid String? @unique

  // Allowed values: "granted", "declined", or null if never asked.
  recordingConsent String?

  // True once recording actually started. Null before the call connects.
  recordingEnabled Boolean?

  // The bare S3 object KEY for the MP3 (e.g.
  // "maincar-call-recordings/{orgId}/{callId}.mp3"), written by the upload job.
  // NOT a link a browser can open: the GET-one route presigns it at request time
  // (see routes/calls.ts). Null until the recording has been uploaded.
  recordingUrl String?

  // Allowed values: "pending", "stored", "failed". Tracks the async upload of the
  // Twilio recording into S3 (jobs/uploadRecording.ts), separate from the call's
  // own lifecycle `status` above: a call can complete cleanly while its recording
  // upload is still pending or has failed, and those are not the same fact.
  recordingStatus String @default("pending")

  // Allowed values: "pending", "done", "failed", "skipped-not-recorded".
  transcriptStatus String  @default("pending")
  transcript       String?

  // Billed duration in whole seconds, from Twilio's status callback.
  durationS Int?

  startedAt DateTime?
  endedAt   DateTime?

  // --- CRM spine (MAI-132, spec §6) ------------------------------------------
  // Who and what this call was with. All three are NULLABLE so a call from an
  // unknown number still logs — the number→person match (lib/callMatch.ts) just
  // leaves them null. onDelete: SetNull, never Cascade: trashing or deleting a
  // Person, Company, or Deal must never destroy call history — the row survives
  // and only its link goes null. At call-log time the match fills personId (and
  // companyId, from that person's company); dealId is left for the caller to set
  // from context, because a phone number resolves to a person, not to one of
  // their possibly-many deals.
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
  @@index([toE164])
  @@index([createdAt])
  // The hot path: a Person/Company page loads its recent calls in one indexed
  // round-trip, newest first (Checkpoint A).
  @@index([orgId, personId, createdAt])
  @@index([orgId, companyId, createdAt])
  @@index([orgId, dealId, createdAt])
}

// -----------------------------------------------------------------------------
// Email composer
//
// The dock (docs/specs/SPEC-composer-dock.md) keeps half-written emails in the
// corner of the app. One row per card.
// -----------------------------------------------------------------------------

// One half-written email. Org-scoped AND user-scoped: a draft is private to its
// author, so every read and every write filters on userId as well as orgId, and
// another member's draft is a 404 — never a 403, which would confirm it exists.
model EmailDraft {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The rep writing it. Cascade: a deleted user's unsent drafts go with them.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The mailbox this will go out on. Null until composer-mailbox lands.
  // Deliberately a bare String, not a relation: MailAccount does not exist yet.
  mailAccountId String?

  // The record the composer was opened from, so reopening lands back in context.
  // Null until the CRM port lands. Also a bare String, for the same reason.
  recordId String?

  toAddrs  String[]
  ccAddrs  String[]
  bccAddrs String[]

  subject  String?
  bodyHtml String?

  // Dock state, so a refresh restores the corner exactly as the rep left it.
  //
  // Two flags, not one, because Gmail's X and its - are different acts. isOpen
  // false means the card is out of the dock but the draft is KEPT — closing an
  // email has never meant throwing it away. isMinimized means the card is still
  // in the dock, collapsed to a chip. Discarding is a DELETE, and nothing else is.
  isOpen      Boolean @default(true)
  isMinimized Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The dock's only query: this rep's drafts in this org, by last edit.
  @@index([orgId, userId, updatedAt])
}

// The org's saved emails — the five a rep sends over and over
// (docs/specs/SPEC-composer-templates.md § Data model).
//
// Org-wide, NOT private to its author. That is the deliberate difference from
// EmailDraft above: a draft is half of one person's unsent email, so it filters
// on userId as well as orgId. A template is a thing the TEAM reuses — a template
// a teammate cannot use is a note to self — so every query filters on orgId
// ALONE and any member may edit or delete any of them (spec § Acceptance
// criteria 2). Per-user private templates are an "ask first" in the spec's
// Boundaries: do not add a userId filter without changing the spec first.
model EmailTemplate {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Who wrote it. Attribution only, never a filter. Nullable + SetNull, matching
  // Invitation.invitedByUser: the template belongs to the ORG, so it has to
  // outlive the rep who wrote it. Cascade would delete the team's templates when
  // their author leaves, and the default Restrict would make that rep undeletable.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  name     String
  subject  String
  bodyHtml String

  // The distinct merge-field ids this template uses, derived server-side from the
  // subject and the body together on EVERY write. Stored so the list can say
  // "uses 3 fields" without re-parsing every body. DERIVED data, never
  // authoritative: the TEXT WINS, and a client-supplied value is ignored. Stays
  // null until merge fields land with the CRM port (SPEC-composer-body.md §
  // Deferred).
  fieldsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The Templates screen's only query: this org's templates, alphabetically.
  @@index([orgId, name])
}

// -----------------------------------------------------------------------------
// Integration Hub — mail/calendar OAuth
//
// The two tables the whole Integration Hub sits on
// (docs/specs/SPEC-int-schema.md § Data model). OAuthConnection holds the
// encrypted grant and the honest status; MailAccount holds the mailbox that
// grant reaches. Deleting the connection deletes the mailbox: without a token
// there is nothing left to send from.
// -----------------------------------------------------------------------------

model OAuthConnection {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // google | microsoft. A String, never a Prisma enum (rules/database-and-prisma.md).
  provider String

  // The provider's own id for this identity. Google: sub. Microsoft: oid.
  // Held so a re-consent under a changed email address still matches the row.
  providerAccountId String
  emailAddress      String

  // Encrypted at rest, format v1.<iv>.<ciphertext>.<tag>. Never logged, never
  // returned by any route, never in a response body — not even to the owner.
  refreshToken String  @db.Text
  accessToken  String? @db.Text
  expiresAt    DateTime?

  // What the provider ACTUALLY granted, not what was asked for. The difference
  // between this and REQUIRED_SCOPES is the whole amber state.
  scopes String[] @default([])

  // connected | limited | error
  status       String  @default("connected")
  // Stable code the client maps to recovery steps. Null when healthy.
  errorCode    String?
  // One line naming what does not work. Empty when healthy.
  statusDetail String?

  // When a live provider call last proved this works. Null until the first Test.
  lastValidatedAt DateTime?
  lastRefreshAt   DateTime?

  mailAccount MailAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One grant per provider per rep. Reconnecting updates rather than duplicates.
  @@unique([orgId, userId, provider])
  @@index([orgId, userId])
}

model MailAccount {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Deleting the grant deletes the mailbox: without a token there is nothing left
  // to send from, and a mailbox that cannot send is not a mailbox.
  connection   OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String          @unique

  provider     String // duplicated from the connection so a list needs no join
  emailAddress String
  displayName  String?

  // Exactly one per (orgId, userId) is true. Moved atomically in mailAccounts.ts.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One mailbox per address per org. Re-connecting updates rather than duplicates.
  @@unique([orgId, emailAddress])
  @@index([orgId, userId])
}

// -----------------------------------------------------------------------------
// CRM — Company (MAI-129, Phase 1 / T1). The identity anchor for an account:
// groups people, deals, and the account feed.
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.15 identity anchors, §5.11 what the DB
// enforces vs. app code). Plan: tasks/plan-crm-schema.md (T1).
//
// name / legalName are NULLABLE on purpose (§5.15): a company can be created from
// just a domain seen on an email, then enriched. App code (routes/companies.ts)
// requires at least one identity ANCHOR — name, domain, or linkedinUrl — because
// "at least one of these nullable columns is non-null" is not a constraint Prisma
// can express. Display name = name ?? domain ?? "Untitled company".
//
// NOTE ON RELATIONS: T1 (MAI-129) landed Company with `orgId` as a plain String
// and no relation, so a deleted org left its companies behind with no cascade. T2
// (MAI-130) establishes the real relation to Org — `onDelete: Cascade`, matching
// PhoneNumber/Call — now that we are adding the models that hang off Company. The
// Person back-relation lands here too (Person.companyId → Company). ownerUserId
// stays a plain String: wiring it to User would mean adding a back-relation to the
// protected User model, and no cascade is needed for a nullable owner pointer
// (the route already scopes writes by orgId). Deal / Email / Meeting back-relations
// arrive with their own tickets (T3, T9, T11).
model Company {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The common name you actually call them ("Google"). Nullable — see the header.
  name String?
  // The formal entity ("Alphabet Inc"), optional. Enrichment fills it.
  legalName String?

  // Business CATEGORY / model: saas | agency | manufacturer | retailer | services
  // | non_profit | ... A user-editable picklist (custom values allowed). Distinct
  // from `industry` below, which is the vertical/sector.
  companyType String?

  domain           String?
  alternateDomains String[] @default([])
  // Company LinkedIn page — an identity anchor + enrichment key.
  linkedinUrl String?

  // Vertical / sector — healthcare | finance | retail | ... Distinct from companyType.
  industry      String?
  sizeEmployees Int?
  // Enrichment-filled; the UI falls back to an initials monogram when absent.
  logoUrl String?

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)

  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyParent", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies  Company[] @relation("CompanyParent")

  ownerUserId String?

  // on_deck | on_hold | backburner | disqualified
  attentionStatus String    @default("on_deck")
  attentionReason String?
  callbackDate    DateTime?
  source          String? // manual | import | enrichment | inbound_call | ...

  customJson Json @default("{}")

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  // The people who work here (Person.companyId → Company). SetNull on that side,
  // so trashing/deleting a company does not delete its people.
  people Person[]
  // The deals for this account (Deal.companyId → Company). SetNull on that side
  // too, so trashing/deleting a company does not delete its deals (MAI-131 T3).
  deals Deal[]
  // Calls rolled up to this account (Call.companyId → Company). SetNull on that
  // side, so deleting a company never destroys call history (MAI-132 T4).
  calls Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, domain]) // HubSpot's natural key. NULL domains do not collide.
  @@index([orgId])
  @@index([orgId, parentCompanyId])
  @@index([orgId, ownerUserId])
}

// -----------------------------------------------------------------------------
// CRM — Person + PersonPhone + PersonEmail (MAI-130, Phase 1 / T2). The person is
// the thing we dial: the centre of the product. Its dialable values are ROWS, not
// columns, because a dialer must know which numbers are dead (spec §5.5).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.5 phones/emails as rows with status,
// §5.11 DB-enforced vs app-enforced, §5.15 identity anchors). Plan: T2.
//
// Two invariants the database CANNOT express, enforced in routes/people.ts:
//   1. Identity anchor — a person needs at least one of a name part, an email, a
//      phone, or linkedinUrl. The rule spans nullable columns AND the child
//      phone/email rows, so no Prisma constraint can state it.
//   2. Primary invariant — at most one primary phone (and one primary email) per
//      person; if the person has ≥1 phone, exactly one is primary. A boolean
//      column cannot see its siblings, so add auto-sets the first primary and
//      delete auto-promotes another.
//
// ownerUserId is a plain String for the same reason it is on Company: wiring it to
// User would add a back-relation to the protected model, and a nullable owner
// pointer needs no cascade.
// -----------------------------------------------------------------------------
model Person {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  firstName          String? // NULLABLE — see the identity-anchor rule (§5.15)
  lastName           String? // nullable: not every name splits into two parts
  preferredFirstName String? // nickname the dialer says, e.g. "Bob" for "Robert"
  title              String?
  linkedinUrl        String? // an identity anchor + enrichment/personalization key
  // Display name = preferredFirstName ?? firstName (+ lastName), else an email, else "Unknown".

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerUserId String?

  timeZone String? // IANA, for "is it a decent hour to call"

  // decision_maker | gatekeeper | champion | influencer | user | other
  persona String?

  // on_deck | on_hold | backburner | disqualified — a fixed system enum (§5.6a).
  attentionStatus String    @default("on_deck")
  attentionReason String?
  callbackDate    DateTime?

  source          String? // manual | import | enrichment | inbound_call | ...
  lastContactedAt DateTime?

  nameAudioUrl String? // clip of them saying their own name, played pre-ring — PHASE 2 fill

  customJson Json @default("{}")

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)
  isArchived   Boolean   @default(false)
  deletedAt    DateTime?

  phones    PersonPhone[]
  addresses PersonEmail[] // the person's own email addresses, each with a status
  // This person's role on each deal they are on. A person can hold DIFFERENT roles
  // on DIFFERENT deals — champion on one, influencer on another (MAI-131 T3).
  dealRoles DealPersonRole[]
  // Calls with this person (Call.personId → Person). SetNull on that side, so
  // deleting a person never destroys call history (MAI-132 T4).
  calls     Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, companyId])
  @@index([orgId, ownerUserId])
  @@index([orgId, attentionStatus])
  @@index([orgId, callbackDate])
}

// -----------------------------------------------------------------------------
// Dialable identity — one row per value, each with its own life story.
// -----------------------------------------------------------------------------

model PersonPhone {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  e164      String
  extension String?
  label     String  @default("other") // mobile | direct | work | main | home | other

  // Deliverability status — decays, re-verifiable. reachable | unverified | dead.
  status String  @default("unverified")
  // never_valid | no_longer_in_service | wrong_person — the reason behind "dead".
  reason String?

  // DNC is SEPARATE from status: legal, permanent, deliberate. Never fold into status.
  isDnc     Boolean @default(false)
  dncReason String?

  // mobile | landline | voip — Twilio Lookup. Blocks SMS to a landline; sorts dials.
  lineType          String?
  lineTypeCheckedAt DateTime?

  source    String? // manual | import | enrichment | inbound_call | ai_call
  isPrimary Boolean @default(false) // app-enforced: at most one true per person (§5.11)

  // Dial-order signals — cheap rollups written by the dialer; bestTimeToCall is a
  // nightly job (PHASE 2). Freshness is derived from lastDialedAt, not stored.
  timesDialed     Int       @default(0)
  lastDialedAt    DateTime?
  timesConnected  Int       @default(0)
  lastConnectedAt DateTime?
  bestTimeToCall  String? // morning | afternoon | evening | any — blank until enough data

  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, e164]) // re-adding the same number is idempotent
  @@index([orgId])
  @@index([orgId, e164])
  @@index([orgId, status])
}

model PersonEmail {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  address String
  label   String @default("work") // work | personal | other

  // Same shape as PersonPhone. reachable | unverified | dead.
  status String  @default("unverified")
  reason String? // hard_bounce | never_valid | wrong_person

  isDnc     Boolean @default(false) // e.g. unsubscribed — legal, separate from status
  dncReason String?

  source    String?
  isPrimary Boolean @default(false) // app-enforced: at most one true per person (§5.11)

  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, address]) // re-adding the same address is idempotent
  @@index([orgId])
  @@index([orgId, address])
}

// -----------------------------------------------------------------------------
// CRM — Deal spine (MAI-131, Phase 1 / T3). A Deal is one possible sale: pipeline,
// forecast, and the reason to call. Pipeline / PipelineStage configure the stages
// a deal moves through; DealPersonRole is the buying committee (multi-threading).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.4 typed FKs + a named join for an edge
// that carries data, §5.8 money as integer minor units). Plan: T3.
//
// Two rules the database CANNOT enforce, so they live in routes/deals.ts:
//   1. A Deal's stage must belong to the Deal's pipeline. stageId and pipelineId
//      are each a valid FK on their own, but "this stage is in that pipeline" is a
//      cross-row relationship no single FK can state.
//   2. Money is stored in integer minor units (BigInt), never a float — the route
//      accepts and returns it as an exact integer string so it round-trips with no
//      drift (§5.8).
//
// ownerUserId is a plain String, for the same reason it is on Company/Person:
// wiring it to User would add a back-relation to the protected model, and a
// nullable owner pointer needs no cascade.
// -----------------------------------------------------------------------------

// The ordered list of stages a deal moves through (e.g. "New Business": New →
// Qualified → Proposal → Won). Exactly one Pipeline per org is seeded later (T6);
// the model already supports a second (e.g. "Renewals") with no migration.
model Pipeline {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  stages PipelineStage[]
  deals  Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// One step in a Pipeline. winProbability weights the forecast; outcome tells the
// board which columns end the deal.
model PipelineStage {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name           String
  color          String @default("#94a3b8")
  sortOrder      Int
  winProbability Int    @default(0) // 0..100, weights the forecast

  // open | won | lost — a fixed system enum. Which columns end the deal.
  outcome String @default("open")

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([pipelineId, sortOrder])
}

model Deal {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String

  // SetNull, not Cascade: trashing a company must not delete its deals.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Which of the org's pipelines this ONE deal runs through. Restrict: a pipeline
  // still carrying a deal cannot be deleted out from under it.
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  // The deal's current stage. Restrict for the same reason. App code guarantees
  // this stage belongs to `pipeline` — the DB cannot express that cross-row rule.
  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  // Integer minor units (cents; JPY = whole yen), never a float (§5.8). Nullable
  // until a deal is sized. currency is ISO-4217.
  amountMinor BigInt?
  currency    String  @default("USD")

  closeDate DateTime?

  // open | won | lost — a fixed system enum (§5.6a).
  status     String  @default("open")
  lostReason String? // a user picklist; free text for now

  ownerUserId String?

  customJson Json @default("{}")

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)
  isArchived   Boolean   @default(false)
  deletedAt    DateTime?

  personRoles DealPersonRole[]
  // Calls logged against this deal (Call.dealId → Deal). SetNull on that side, so
  // deleting a deal never destroys call history (MAI-132 T4).
  calls       Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, companyId])
  @@index([orgId, stageId])
  @@index([orgId, ownerUserId])
  @@index([orgId, closeDate])
}

// Salesforce's OpportunityContactRole: the buying committee. Named *Person*Role to
// match "Person" as the object name everywhere in this schema (§5.4). The
// @@unique([dealId, personId]) means a person appears at most ONCE per deal — but
// the SAME person can hold DIFFERENT roles on DIFFERENT deals (multi-threading).
model DealPersonRole {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // champion | decision_maker | economic_buyer | influencer | blocker | user | other
  role      String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, personId])
  @@index([orgId])
  @@index([personId])
}

// -----------------------------------------------------------------------------
// Schema-as-data (MAI-133 T5) — ObjectDef + AttributeDef describe BOTH the typed
// tables (Person/Company/Deal/...) and the generic Record rows. The UI, the field
// editor, validation, and views all read these rows and never care where a value
// physically sits (spec §5.1). Adding a custom FIELD is a row insert here, never a
// migration; adding a standard field is a real migration (§5.1, §5.6a).
// -----------------------------------------------------------------------------

// One row per object type in an org. Standard objects (person/company/deal/...)
// are seeded with isStandard=true and can be HIDDEN but never archived/deleted —
// the app's own code depends on them (§5.10, §10.2). Custom objects the user
// invents are storage="record" and live as Record rows (§5.1).
model ObjectDef {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  slug       String // person | company | deal | call | task | note | <custom>
  name       String // singular display label, e.g. "Company"
  namePlural String // e.g. "Companies" — navbar links, "+ New" buttons, table headers
  icon       String? // a lucide icon id, e.g. "building-2" (§9). Seeded for standard objects.
  iconColor  String? // optional tint for the icon, e.g. a purple custom object (§9)

  // "table"  = a real Postgres table; standard columns + customJson.
  // "record" = a Record row with valuesJson. Custom objects only.
  storage String @default("record")

  isStandard   Boolean @default(false) // app-seeded and app-depended-on
  isFirstClass Boolean @default(true) // gets a navbar link and a table

  isHidden   Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime? // blocked when isStandard

  attributes AttributeDef[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
}

// One row per field on an object. type is a semantic type from §8's table; the
// value's physical home is `storage`: "column" (a real table column, always
// isSystem), "custom" (customJson/valuesJson), or "list" (ListEntry.valuesJson).
// isSystem fields can be renamed/hidden but never deleted or retyped (§10.2).
model AttributeDef {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  objectId String
  object   ObjectDef @relation(fields: [objectId], references: [id], onDelete: Cascade)

  slug        String
  name        String // display label shown in the UI, may differ from the slug
  description String? // one-line help text shown in the field editor / tooltip
  icon        String?

  // text | number | checkbox | date | timestamp | phone | email | url | domain
  // | select | multiselect | status | currency | rating | location
  // | person_name | record_reference | user_reference | ai   (full table in §8)
  type String

  optionsJson    Json? // select options: [{ value, label, color, order, isArchived }] (§5.6a)
  refObjectId    String? // for record_reference
  formatJson     Json? // display format (Sheets-style presets / custom mask)
  validationJson Json? // min/max/pattern/required-strict

  isIdentity Boolean @default(false) // a unique-to-one-entity field; drives dedupe

  // "column" = lives in a real column on the table (isSystem is always true here)
  // "custom" = lives in customJson / valuesJson
  // "list"   = lives in ListEntry.valuesJson
  storage String @default("custom")

  isMulti    Boolean @default(false)
  isRequired Boolean @default(false)
  isUnique   Boolean @default(false)
  isReadOnly Boolean @default(false)
  isSystem   Boolean @default(false) // rename/hide OK; delete and retype blocked

  defaultJson Json?
  sortOrder   Int   @default(0)

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([objectId, slug])
  @@index([orgId])
}
