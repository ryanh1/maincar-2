// The connection URL is NOT set here — it comes from prisma.config.ts, which
// reads the repo-root .env. That is the Prisma 7 style.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// House rules for every model in this file (CLAUDE.md → Database / Prisma):
//
//   1. EVERY model has `createdAt` and `updatedAt`. No exceptions.
//   2. NEVER use a Prisma `enum`. Use a String and document the allowed values in
//      a comment beside the field, with a matching TypeScript union in app code.
//      Postgres enums need an ALTER TYPE dance to add or remove a value; a String
//      column just changes.
//   3. Every org-scoped model carries `orgId` and is indexed on it. Reads AND
//      writes filter on it.
// -----------------------------------------------------------------------------

model Org {
  id        String  @id @default(cuid())
  name      String?
  logo      String?
  // Private MinIO/S3 object key for the organization photo. API responses sign
  // a short-lived URL from this key rather than storing a browser-readable URL.
  avatarKey String?
  enabled   Boolean @default(true)

  // Organization-level outbound call recording policy. The saved blocked set is
  // authoritative; UNKNOWN covers a number whose destination state cannot resolve.
  recordCalls                Boolean  @default(true)
  blockTwoPartyConsentStates Boolean  @default(true)
  recordingAllowedStates     String[] @default([])
  recordingBlockedStates     String[] @default(["CA", "CT", "DE", "FL", "IL", "MD", "MA", "MI", "MT", "NV", "NH", "OR", "PA", "WA", "UNKNOWN"])

  // Which version of the standard-schema seed (server/src/crm/standardObjects.ts)
  // this org has had applied. Set by seedOrg on org creation; a later release bumps
  // CURRENT_SEED_VERSION and the insert-missing-only backfill catches orgs behind
  // it (MAI-134 T6, spec §10.2). 0 = never seeded.
  seedVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  invitations        Invitation[]
  phoneNumbers       PhoneNumber[]
  calls              Call[]
  dispositions       DispositionDef[]
  transcripts        Transcript[]
  transcriptSegments TranscriptSegment[]
  callSpeakers       CallSpeaker[]
  callComments       CallComment[]
  callCommentReactions CallCommentReaction[]
  emailDrafts        EmailDraft[]
  emailTemplates     EmailTemplate[]
  oauthConnections   OAuthConnection[]
  mailAccounts       MailAccount[]

  // CRM spine (MAI-129 T1, MAI-130 T2). Back-relations so a deleted org cascades
  // its CRM rows away — the same onDelete: Cascade the dialer models already use.
  companies    Company[]
  people       Person[]
  personPhones PersonPhone[]
  personEmails PersonEmail[]

  // Deal spine (MAI-131 T3). Back-relations so a deleted org cascades its deals,
  // pipelines, stages, and per-deal roles away — the same onDelete: Cascade the
  // rest of the CRM spine already uses.
  pipelines       Pipeline[]
  pipelineStages  PipelineStage[]
  deals           Deal[]
  dealPersonRoles DealPersonRole[]

  // Schema-as-data (MAI-133 T5). Back-relations so a deleted org cascades its
  // object/attribute definitions away — the same onDelete: Cascade the rest of
  // the CRM spine already uses.
  objectDefs    ObjectDef[]
  attributeDefs AttributeDef[]
  savedViews    SavedView[]
  detailLayouts DetailLayout[]

  // Custom objects (MAI-135 T7). Back-relations so a deleted org cascades its
  // custom-object rows and their links away — the same onDelete: Cascade the rest
  // of the CRM spine already uses.
  records     Record[]
  recordLinks RecordLink[]

  // Field history + the trust seam (MAI-136 T8). Back-relations so a deleted org
  // cascades its history and provenance rows away — the same onDelete: Cascade the
  // rest of the CRM spine already uses.
  fieldHistory FieldHistory[]
  provenance   Provenance[]

  // Email activity (MAI-137 T9). Back-relations so a deleted org cascades its
  // messages, their participants, and their attachments away — the same
  // onDelete: Cascade the rest of the CRM spine already uses.
  emails            Email[]
  emailParticipants EmailParticipant[]
  emailAttachments  EmailAttachment[]

  // Text activity (MAI-138 T10). Back-relations so a deleted org cascades its
  // messages and their MMS media away — the same onDelete: Cascade the rest of
  // the CRM spine already uses.
  smsMessages  SmsMessage[]
  messageMedia MessageMedia[]

  // Calendar activity (MAI-139 T11). Back-relations so a deleted org cascades its
  // meetings and their attendees away — the same onDelete: Cascade the rest of the
  // CRM spine already uses.
  meetings         Meeting[]
  meetingAttendees MeetingAttendee[]

  // The denormalized feed (MAI-140 T12). Back-relation so a deleted org cascades
  // its feed rows away — the same onDelete: Cascade the rest of the CRM spine
  // already uses.
  activityEntries ActivityEntry[]

  // Work objects (MAI-141 T13). Back-relations so a deleted org cascades its
  // tasks and notes away — the same onDelete: Cascade the rest of the CRM spine
  // already uses. Their links ride on RecordLink, which already cascades above.
  tasks Task[]
  notes Note[]

  // Lists (MAI-142 T14). Back-relations so a deleted org cascades its lists and
  // the entries on them away — the same onDelete: Cascade the rest of the CRM
  // spine already uses.
  lists       List[]
  listEntries ListEntry[]

  // Saved reports (MAI-145). A report belongs to an organization, while its
  // owner controls this first lifecycle slice. Sharing arrives separately.
  reports          Report[]
  analyticsRollups AnalyticsRollup[]

  // Shared in-app notifications (MAI-235). A source event is one durable object
  // with one recipient-owned lifecycle row per teammate; deleting the org clears
  // both halves together.
  notificationObjects NotificationObject[]
  notifications       Notification[]

  // Teams are organization-scoped working groups. The lead is a coordination
  // attribute, never a permission grant; TeamMember is the roster that proves
  // the lead belongs to the team (MAI-290).
  teams       Team[]
  teamMembers TeamMember[]

  // Inbound voicemail and pre-recorded drops (MAI-39 through MAI-53). Greeting
  // candidates keep the active greeting playable while a replacement validates.
  // All relations cascade when the tenant is deleted, like the other dialer data.
  voicemails         Voicemail[]
  voicemailGreetings VoicemailGreeting[]
  voicemailDrops     VoicemailDrop[]
}

model User {
  id String @id @default(cuid())

  // The Firebase Auth uid. This is the join between the ID token on a request and
  // the row here; it is how `requireAuth` resolves a caller.
  firebaseUid String @unique

  email     String  @unique
  firstName String?
  lastName  String?
  title     String?
  imageUrl  String?
  // Private MinIO/S3 object key for this user's uploaded profile photo.
  avatarKey String?

  // false blocks sign-in without deleting anything.
  enabled Boolean @default(true)

  // Global platform roles: basic, admin, superadmin. Per-org roles live in Membership.
  roles String[] @default(["basic"])

  // IANA timezone, e.g. "America/New_York". Captured at onboarding, defaulted
  // from the browser. Every time-of-day shown to this user renders in it
  // (CLAUDE.md → Dates & Times).
  timeZone String?

  // The org this user currently has selected (for UI context; not used for auth).
  // Nullable — the user may not have any org yet (edge case after account creation).
  currentOrgId String?

  memberships         Membership[]
  teamsLed            Team[]           @relation("TeamLead")
  teamMemberships     TeamMember[]
  invitationsSent     Invitation[]      @relation("InvitationSender")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptor")
  phoneNumbers        PhoneNumber[]
  calls               Call[]
  callCommentsAuthored CallComment[]         @relation("CallCommentAuthor")
  callCommentReactions CallCommentReaction[]
  emailDrafts         EmailDraft[]
  emailTemplates      EmailTemplate[]
  emailSignatures     EmailSignature[]
  oauthConnections    OAuthConnection[]
  mailAccounts        MailAccount[]
  reportsOwned        Report[] @relation("ReportOwner")
  reportsDeleted      Report[] @relation("ReportDeletedBy")

  // Texts sent or received on this rep's number (SmsMessage.mailboxUserId →
  // User). SetNull on that side, so deleting a user never destroys the org's
  // record of what was said (MAI-138 T10).
  smsMessages SmsMessage[] @relation("SmsMailbox")

  // Feed rows this user is the actor on (ActivityEntry.createdByUserId → User).
  // SetNull on that side, so deleting a user never destroys the org's record of
  // what happened (MAI-140 T12).
  activityEntries ActivityEntry[]

  // Work assigned to and written by this rep (MAI-141 T13). SetNull on both
  // sides: deleting a user must not delete the org's tasks or its notes. An
  // unassigned task and an authorless note are both real states.
  tasksAssigned Task[] @relation("TaskAssignee")
  notesAuthored Note[] @relation("NoteAuthor")

  // Notification actors and recipients are separate relations. Removing an actor
  // keeps the event (with a null actor); removing a recipient removes only that
  // person's private inbox row.
  notificationObjectsAuthored NotificationObject[] @relation("NotificationActor")
  notificationsReceived       Notification[]       @relation("NotificationRecipient")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentOrgId])
}

// Join table: users can belong to multiple orgs, each with their own role set.
model Membership {
  id String @id @default(cuid())

  userId String
  orgId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "owner", "admin", "basic". Per-org role set (different from
  // global roles). A String[] rather than an enum, per rule 2 in the schema
  // header. "owner" is never granted from the member list — ownership moves by
  // transfer — so it is absent from `assignableRolesSchema`.
  roles String[] @default(["basic"])

  // Offboarding flips this to false. The row stays so re-inviting the same person
  // reactivates it under @@unique([userId, orgId]) instead of colliding, and so a
  // departure is still visible in the record. EVERY membership read filters on it:
  // an inactive membership is the same as no membership.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([orgId, isActive])
}

// A reusable team for Settings, shared filters, and reporting. A team is
// archived rather than deleted so historical references can remain intact.
// `leadUserId` is required; routes verify the lead has an active Membership in
// this org and a matching TeamMember row before every create or roster change.
model Team {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String

  leadUserId String
  lead       User @relation("TeamLead", fields: [leadUserId], references: [id], onDelete: Restrict)

  // Soft archive: catalog records remain stable and no CRM row is changed.
  archivedAt DateTime?

  members TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, archivedAt])
  @@index([orgId, leadUserId])
}

// One active-roster entry per person per team. `orgId` is intentionally copied
// here so every tenant-scoped roster query has a direct tenant boundary.
model TeamMember {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([orgId])
  @@index([orgId, userId])
  @@index([orgId, teamId])
}

// Member invitations to orgs.
model Invitation {
  id    String @id @default(cuid())
  token String @unique

  email String
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "PENDING", "ACCEPTED", "EXPIRED", "REVOKED"
  status String @default("PENDING")

  // Roles this invite grants (basic, admin, etc.)
  roles String[] @default(["basic"])

  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  invitedByUserId String?
  invitedByUser   User?   @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([email])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Dialer
//
// The dialer spec (docs/specs/SPEC-DIALER-REBUILD.md) calls the tenant key
// `workspaceId`. This schema has always called it `orgId` and points it at `Org`
// (CLAUDE.md → Database / Prisma: "Every org-scoped model carries orgId"). One
// name for one thing, so the dialer models use `orgId` too.
// -----------------------------------------------------------------------------

// A Twilio number an org owns and hands to one of its members. A user may hold
// several; at most one of theirs is the caller ID for outbound calls.
model PhoneNumber {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member this number belongs to, or null when the org holds it and nobody
  // has it yet. Nullable since MAI-197: an admin can take a number back from a
  // departing rep, and the number keeps costing the org its monthly rental in the
  // gap before someone else gets it — so "held by nobody" has to be storable.
  // An unassigned number is never `isActiveForOutbound`: a caller ID with no
  // caller cannot place a call.
  //
  // Restrict, not Cascade: releasing a number is a Twilio call, not a row delete,
  // so a user who still holds one cannot be deleted out from under it.
  assignedUserId String?
  assignedUser   User?   @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)

  // E.164, e.g. "+12025550123".
  e164 String

  // Twilio's SID for the number. Null until the provisioning job has actually
  // bought it — the row is written first, with status "searching".
  twilioSid String?

  // Allowed values: "searching", "active", "releasing", "failed".
  status String @default("searching")

  // At most one true per user. Enforced in the route, in a transaction.
  isActiveForOutbound Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([assignedUserId])
  @@index([e164])
}

// One call, inbound or outbound, and everything learned about it afterwards.
model Call {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member who placed or received the call. Restrict so call history is
  // never destroyed as a side effect of deleting a user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // E.164 both sides. fromE164 is the caller ID actually used.
  fromE164 String
  toE164   String

  // Allowed values: "outbound", "inbound".
  direction String

  // Allowed values: "queued", "ringing", "in-progress", "completed", "busy",
  // "failed", "no-answer", "canceled".
  status String @default("queued")

  // Twilio's SID for the call. Null until Twilio accepts it. Unique so the
  // status and recording webhooks can look the row up by SID alone; Postgres
  // allows many NULLs under a unique index, so queued rows do not collide.
  twilioCallSid String? @unique

  // Allowed values: "granted", "declined", or null if never asked.
  recordingConsent String?

  // The server-owned policy decision made synchronously when the call is queued.
  // Null preserves the history of calls created before MAI-260 introduced policy.
  recordingPlanned Boolean?
  // Allowed values: "allowed", "recording-disabled", "two-party-consent-state",
  // "state-not-allowed", "unknown-destination-state". Null for legacy calls.
  recordingReason  String?
  // USPS state resolved from the destination NPA, or null when unknown/non-US.
  destinationState String?

  // True once recording actually started. Null before the call connects.
  recordingEnabled Boolean?

  // The bare S3 object KEY for the MP3 (e.g.
  // "maincar-call-recordings/{orgId}/{callId}.mp3"), written by the upload job.
  // NOT a link a browser can open: the GET-one route presigns it at request time
  // (see routes/calls.ts). Null until the recording has been uploaded.
  recordingUrl String?

  // Allowed values: "pending", "stored", "failed". Tracks the async upload of the
  // Twilio recording into S3 (jobs/uploadRecording.ts), separate from the call's
  // own lifecycle `status` above: a call can complete cleanly while its recording
  // upload is still pending or has failed, and those are not the same fact.
  recordingStatus String @default("pending")

  // Allowed values: "pending", "done", "failed", "skipped-not-recorded".
  transcriptStatus String  @default("pending")
  transcript       String?

  // The rep-logged business outcome. This is deliberately separate from
  // `status`, which remains the technical Twilio lifecycle.
  dispositionId String?
  disposition   DispositionDef? @relation(fields: [dispositionId], references: [id], onDelete: SetNull)
  noteText      String?

  // The canonical final pass. The legacy flat `transcript` stays temporarily so
  // existing readers remain compatible while consumers move to timed segments.
  finalTranscript Transcript?
  speakers        CallSpeaker[]
  comments        CallComment[]

  // Billed duration in whole seconds, from Twilio's status callback.
  durationS Int?

  startedAt DateTime?
  endedAt   DateTime?

  // --- CRM spine (MAI-132, spec §6) ------------------------------------------
  // Who and what this call was with. All three are NULLABLE so a call from an
  // unknown number still logs — the number→person match (lib/callMatch.ts) just
  // leaves them null. onDelete: SetNull, never Cascade: trashing or deleting a
  // Person, Company, or Deal must never destroy call history — the row survives
  // and only its link goes null. At call-log time the match fills personId (and
  // companyId, from that person's company); dealId is left for the caller to set
  // from context, because a phone number resolves to a person, not to one of
  // their possibly-many deals.
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // User-defined call fields. Every table-backed standard object exposes this
  // JSON bag to the generic Objects list query.
  customJson Json @default("{}")

  // The generic Objects list excludes soft-deleted table rows.
  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
  @@index([toE164])
  @@index([createdAt])
  // The hot path: a Person/Company page loads its recent calls in one indexed
  // round-trip, newest first (Checkpoint A).
  @@index([orgId, personId, createdAt])
  @@index([orgId, companyId, createdAt])
  @@index([orgId, dealId, createdAt])
  @@index([orgId, dispositionId])
}

// A managed, organization-scoped call outcome. `value` is the stable machine
// key used in filters while `label` is safe for a rep to rename.
model DispositionDef {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  value String
  label String
  // One of option-1 through option-8. Stored as a semantic token name so the
  // UI keeps working in dark mode rather than persisting a raw color.
  color String @default("option-1")
  // Optional Lucide icon name.
  icon String?
  // Allowed values: "connected", "not_connected".
  category String @default("not_connected")
  isStandard Boolean @default(false)
  sortOrder Int @default(0)
  isArchived Boolean @default(false)

  calls Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, value])
  @@index([orgId, isArchived, sortOrder])
}

// One canonical final pass for a call. Provider-owned text and timing live below
// this row; human identity decisions live in CallSpeaker so reprocessing does
// not silently replace them.
model Transcript {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One row means one final pass per call. A later provider run updates this row
  // atomically instead of accumulating competing "final" versions.
  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  // Allowed values: "deepgram", "legacy".
  provider  String
  plainText String

  segments TranscriptSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// A provider-owned, timed utterance within a final transcript. `words` is the
// provider's per-word timing payload; callers replace these rows as a set when a
// transcript is regenerated, without touching CallSpeaker.
model TranscriptSegment {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  transcriptId String
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  position   Int
  speakerKey String
  startMs    Int
  endMs      Int
  text       String
  words      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transcriptId, position])
  @@index([orgId])
  @@index([transcriptId, speakerKey])
}

// A durable identity decision for one provider speaker key on a call. This is
// deliberately independent of TranscriptSegment so provider replacement cannot
// overwrite a rep's confirmed identity or manual override.
model CallSpeaker {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  speakerKey  String
  displayName String?
  // Allowed values: "provider", "crm", "manual".
  source      String
  evidence    Json?
  confidence  Float?

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  confirmedAt    DateTime?
  manualOverride Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([callId, speakerKey])
  @@index([orgId])
  @@index([orgId, personId])
}

// A discussion item pinned to one authoritative media moment. Only roots carry
// anchors; a reply reaches the same moment through its root parent, so transcript
// regeneration can never move a reply independently of the thread it belongs to.
model CallComment {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  parentId String?
  parent   CallComment?  @relation("CallCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CallComment[] @relation("CallCommentReplies")

  // Null after author deletion: the org retains the discussion even when a
  // departed teammate's account is removed.
  authorUserId String?
  author       User? @relation("CallCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  // TipTap JSON is the rendered source; bodyText is server-derived with
  // flattenTipTapText and is never accepted as a client assertion.
  bodyJson Json
  bodyText String

  // Required only for root comments. atMs remains authoritative across transcript
  // regeneration; the optional selection data can only re-highlight text.
  atMs                Int?
  anchorEndMs         Int?
  anchorQuote         String?
  selectionStartChar  Int?
  selectionEndChar    Int?
  transcriptId        String?

  // Roots with replies are tombstoned; leaf comments can be removed completely.
  deletedAt DateTime?

  reactions CallCommentReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, callId, createdAt])
  @@index([parentId, createdAt])
}

// A user's one emoji on one comment. The compound key makes a retry of the same
// reaction idempotent at the database boundary rather than relying on a racey read.
model CallCommentReaction {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  commentId String
  comment   CallComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([commentId, userId, emoji])
  @@index([orgId])
  @@index([commentId, createdAt])
}

// An immutable personal-greeting candidate. At most one candidate per org has
// status "active"; workers may only move a candidate to "ready", and an
// authorized explicit promotion moves it to "active".
model VoicemailGreeting {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Bare object keys only — never signed URLs. sourceKey is the immutable upload
  // and storageKey is the converted MP3 that can be signed after authorization.
  sourceKey  String?
  storageKey String?

  // Allowed values: "uploading", "transcoding", "ready", "failed", "active",
  // "deleted". The worker never activates a candidate; a member confirms that
  // transition after it has been made ready.
  status String @default("uploading")

  // A required caller-supplied key makes a retry of one upload intent return the
  // same candidate instead of producing duplicate media. Its request hash keeps
  // accidental key reuse with different bytes from silently succeeding.
  idempotencyKey String
  contentHash    String

  durationSeconds Int?
  failureReason   String?
  uploadedAt      DateTime?
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
}

// A reusable, pre-recorded voicemail drop in an org's library (MAI-53). The
// audio key is private storage, never a browser-readable URL; callers presign it
// when they need playback. `isDefault` is protected by a partial unique index in
// this model's migration: an org may have any number of non-default drops, but
// at most one default.
model VoicemailDrop {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Pickable label for the library and the bare S3 object key for its MP3.
  name     String
  audioUrl String

  // Length in whole seconds, derived during upload before the drop is available.
  duration Int

  isDefault Boolean @default(false)

  // Allowed values: "pending", "done", "failed".
  transcriptStatus String  @default("pending")
  transcript       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, name])
}

// One inbound call that went to voicemail, and what was learned from it after
// (MAI-39, MAI-40, MAI-41).
model Voicemail {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Twilio's CallSid for the inbound call, known at row-creation time (the
  // voice webhook, MAI-39). Unique so the recording-completion webhook
  // (MAI-40) can look the row up by CallSid alone.
  callSid String @unique

  // E.164 both sides, same meaning as Call.fromE164 / Call.toE164.
  fromE164 String
  toE164   String

  // Which greeting the caller heard: the bare S3 key of the org's
  // VoicemailGreeting.audioUrl at record time, or null if the org has none
  // and the default greeting played instead. Not a relation, since the org's
  // greeting can be replaced later and this should keep recording what THIS
  // caller actually heard.
  greeting String?

  // The bare S3 object KEY for the MP3 (e.g.
  // "maincar-voicemail-drops/{orgId}/{voicemailId}.mp3"), written by the
  // recording callback (MAI-40). Null until the recording has been stored.
  recordingUrl String?

  // Allowed values: "pending", "done", "failed".
  transcriptStatus String  @default("pending")
  transcript       String?

  // Billed duration in whole seconds, from Twilio's recording callback.
  durationS Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, createdAt])
}

// -----------------------------------------------------------------------------
// Email composer
//
// The dock (docs/specs/SPEC-composer-dock.md) keeps half-written emails in the
// corner of the app. One row per card.
// -----------------------------------------------------------------------------

// One half-written email. Org-scoped AND user-scoped: a draft is private to its
// author, so every read and every write filters on userId as well as orgId, and
// another member's draft is a 404 — never a 403, which would confirm it exists.
model EmailDraft {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The rep writing it. Cascade: a deleted user's unsent drafts go with them.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The mailbox this will go out on. Null until composer-mailbox lands.
  // Nullable + SetNull, not Cascade, same as Email.mailAccountId: a rep
  // disconnecting their mailbox must not delete a half-written email.
  mailAccountId String?
  mailAccount   MailAccount? @relation(fields: [mailAccountId], references: [id], onDelete: SetNull)

  // The record the composer was opened from, so reopening lands back in context.
  // Person / Company / Deal are three separate typed tables (SPEC-CRM-SCHEMA), so
  // one column cannot be a foreign key into all three — the same reason RecordLink
  // uses fromObject/fromId instead of a relation. recordObject names which table;
  // recordId stays a bare String on purpose. Both null, or both set: the pairing
  // and the target row's existence are enforced in server/src/routes/email.ts, not
  // the database, because a single FK column cannot express a polymorphic target.
  recordObject String? // person | company | deal
  recordId     String?

  toAddrs  String[]
  ccAddrs  String[]
  bccAddrs String[]

  subject  String?
  bodyHtml String?

  // `false` means this draft was put away but kept. Discarding is a DELETE.
  isOpen Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The dock's only query: this rep's drafts in this org, by last edit.
  @@index([orgId, userId, updatedAt])
}

// A rep's reusable email sign-off. Signatures are private to the rep rather
// than shared with the organization: names, titles, and contact details belong
// to the sender, and the composer only offers the signed-in rep's list.
model EmailSignature {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Shown in Settings and the composer picker. A signature without a name is
  // impossible to distinguish from another one in the picker.
  name     String
  bodyHtml String

  // `defaultForUser` is the owner id exactly when this is their default and
  // null otherwise. The unique constraint makes two defaults for one rep
  // impossible even when two settings tabs save concurrently.
  isDefault      Boolean @default(false)
  defaultForUser String? @unique

  // The legacy default remains the new-message default for existing composer
  // clients. These two independent ownership keys let a rep choose a different
  // sign-off for new messages and replies without a two-tab race creating two
  // defaults in either context.
  isDefaultForNew      Boolean @default(false)
  defaultForNewUser    String? @unique
  isDefaultForReply    Boolean @default(false)
  defaultForReplyUser  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
}

enum EmailTemplateVisibility {
  PRIVATE
  ORGANIZATION
}

// The org's saved emails — the five a rep sends over and over
// (docs/specs/SPEC-composer-templates.md § Data model). A template starts
// private to its author, or may be shared with their organization. `createdById`
// identifies the private owner; organization templates belong to the org and
// survive an author's departure.
model EmailTemplate {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Who wrote it. Attribution only, never a filter. Nullable + SetNull, matching
  // Invitation.invitedByUser: the template belongs to the ORG, so it has to
  // outlive the rep who wrote it. Cascade would delete the team's templates when
  // their author leaves, and the default Restrict would make that rep undeletable.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  name       String
  subject    String
  bodyHtml   String
  visibility EmailTemplateVisibility @default(PRIVATE)

  // The distinct merge-field ids this template uses, derived server-side from the
  // subject and the body together on EVERY write. Stored so the list can say
  // "uses 3 fields" without re-parsing every body. DERIVED data, never
  // authoritative: the TEXT WINS, and a client-supplied value is ignored. Stays
  // null until merge fields land with the CRM port (SPEC-composer-body.md §
  // Deferred).
  fieldsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The Templates screen's only query: this org's templates, alphabetically.
  @@index([orgId, name])
}

// -----------------------------------------------------------------------------
// Integration Hub — mail/calendar OAuth
//
// The two tables the whole Integration Hub sits on
// (docs/specs/SPEC-int-schema.md § Data model). OAuthConnection holds the
// encrypted grant and the honest status; MailAccount holds the mailbox that
// grant reaches. Deleting the connection deletes the mailbox: without a token
// there is nothing left to send from.
// -----------------------------------------------------------------------------

model OAuthConnection {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // google | microsoft. A String, never a Prisma enum (rules/database-and-prisma.md).
  provider String

  // The provider's own id for this identity. Google: sub. Microsoft: oid.
  // Held so a re-consent under a changed email address still matches the row.
  providerAccountId String
  emailAddress      String

  // Encrypted at rest, format v1.<iv>.<ciphertext>.<tag>. Never logged, never
  // returned by any route, never in a response body — not even to the owner.
  refreshToken String    @db.Text
  accessToken  String?   @db.Text
  expiresAt    DateTime?

  // What the provider ACTUALLY granted, not what was asked for. The difference
  // between this and REQUIRED_SCOPES is the whole amber state.
  scopes String[] @default([])

  // connected | limited | error
  status       String  @default("connected")
  // Stable code the client maps to recovery steps. Null when healthy.
  errorCode    String?
  // One line naming what does not work. Empty when healthy.
  statusDetail String?

  // When a live provider call last proved this works. Null until the first Test.
  lastValidatedAt DateTime?
  lastRefreshAt   DateTime?

  mailAccount MailAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One grant per provider identity per rep. A rep may connect multiple Google or
  // Microsoft accounts; reconnecting the same stable provider identity updates its
  // row instead of creating a duplicate.
  @@unique([orgId, userId, provider, providerAccountId])
  @@index([orgId, userId])
}

model MailAccount {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Deleting the grant deletes the mailbox: without a token there is nothing left
  // to send from, and a mailbox that cannot send is not a mailbox.
  connection   OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String          @unique

  provider     String // duplicated from the connection so a list needs no join
  emailAddress String
  displayName  String?

  // Exactly one per (orgId, userId) is true. Moved atomically in mailAccounts.ts.
  isPrimary Boolean @default(false)

  // The synced messages that came from this mailbox (Email.mailAccountId →
  // MailAccount). ADDITIVE ONLY (MAI-137 T9): nothing else on this model changes,
  // and no credential, token, or scope ever leaves it. The FK on the Email side is
  // NULLABLE with onDelete: SetNull, so disconnecting a mailbox orphans its
  // messages rather than destroying the org's message history.
  emails Email[]

  // The half-written emails queued to go out on this mailbox (MAI-188). Same
  // SetNull reasoning as emails above: disconnecting a mailbox orphans a rep's
  // drafts, never deletes them.
  emailDrafts EmailDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One mailbox per address per org. Re-connecting updates rather than duplicates.
  @@unique([orgId, emailAddress])
  @@index([orgId, userId])
}

// -----------------------------------------------------------------------------
// CRM — Company (MAI-129, Phase 1 / T1). The identity anchor for an account:
// groups people, deals, and the account feed.
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.15 identity anchors, §5.11 what the DB
// enforces vs. app code). Plan: tasks/plan-crm-schema.md (T1).
//
// name / legalName are NULLABLE on purpose (§5.15): a company can be created from
// just a domain seen on an email, then enriched. App code (routes/companies.ts)
// requires at least one identity ANCHOR — name, domain, or linkedinUrl — because
// "at least one of these nullable columns is non-null" is not a constraint Prisma
// can express. Display name = name ?? domain ?? "Untitled company".
//
// NOTE ON RELATIONS: T1 (MAI-129) landed Company with `orgId` as a plain String
// and no relation, so a deleted org left its companies behind with no cascade. T2
// (MAI-130) establishes the real relation to Org — `onDelete: Cascade`, matching
// PhoneNumber/Call — now that we are adding the models that hang off Company. The
// Person back-relation lands here too (Person.companyId → Company). ownerUserId
// stays a plain String: wiring it to User would mean adding a back-relation to the
// protected User model, and no cascade is needed for a nullable owner pointer
// (the route already scopes writes by orgId). Deal / Email / Meeting back-relations
// arrive with their own tickets (T3, T9, T11).
model Company {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The common name you actually call them ("Google"). Nullable — see the header.
  name      String?
  // The formal entity ("Alphabet Inc"), optional. Enrichment fills it.
  legalName String?

  // Business CATEGORY / model: saas | agency | manufacturer | retailer | services
  // | non_profit | ... A user-editable picklist (custom values allowed). Distinct
  // from `industry` below, which is the vertical/sector.
  companyType String?

  domain           String?
  alternateDomains String[] @default([])
  // Company LinkedIn page — an identity anchor + enrichment key.
  linkedinUrl      String?

  // Vertical / sector — healthcare | finance | retail | ... Distinct from companyType.
  industry      String?
  sizeEmployees Int?
  // Enrichment-filled; the UI falls back to an initials monogram when absent.
  logoUrl       String?

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)

  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyParent", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies  Company[] @relation("CompanyParent")

  ownerUserId String?

  // on_deck | on_hold | backburner | disqualified
  attentionStatus String    @default("on_deck")
  attentionReason String?
  callbackDate    DateTime?
  source          String? // manual | import | enrichment | inbound_call | ...

  customJson Json @default("{}")

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  // The people who work here (Person.companyId → Company). SetNull on that side,
  // so trashing/deleting a company does not delete its people.
  people      Person[]
  // The deals for this account (Deal.companyId → Company). SetNull on that side
  // too, so trashing/deleting a company does not delete its deals (MAI-131 T3).
  deals       Deal[]
  // Calls rolled up to this account (Call.companyId → Company). SetNull on that
  // side, so deleting a company never destroys call history (MAI-132 T4).
  calls       Call[]
  // Emails rolled up to this account (Email.companyId → Company). SetNull on that
  // side too, so deleting a company never destroys message history (MAI-137 T9).
  emails      Email[]
  // Texts rolled up to this account (SmsMessage.companyId → Company). SetNull on
  // that side too, for the same reason (MAI-138 T10).
  smsMessages SmsMessage[]
  // Meetings rolled up to this account (Meeting.companyId → Company). SetNull on
  // that side too, for the same reason (MAI-139 T11).
  meetings    Meeting[]
  // The account page's feed (ActivityEntry.companyId → ActivityEntry). SetNull on
  // that side too: trashing a company unlinks its feed rows rather than erasing
  // the record of what happened (MAI-140 T12).
  activity    ActivityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, domain]) // HubSpot's natural key. NULL domains do not collide.
  @@index([orgId])
  @@index([orgId, parentCompanyId])
  @@index([orgId, ownerUserId])
}

// -----------------------------------------------------------------------------
// CRM — Person + PersonPhone + PersonEmail (MAI-130, Phase 1 / T2). The person is
// the thing we dial: the centre of the product. Its dialable values are ROWS, not
// columns, because a dialer must know which numbers are dead (spec §5.5).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.5 phones/emails as rows with status,
// §5.11 DB-enforced vs app-enforced, §5.15 identity anchors). Plan: T2.
//
// Two invariants the database CANNOT express, enforced in routes/people.ts:
//   1. Identity anchor — a person needs at least one of a name part, an email, a
//      phone, or linkedinUrl. The rule spans nullable columns AND the child
//      phone/email rows, so no Prisma constraint can state it.
//   2. Primary invariant — at most one primary phone (and one primary email) per
//      person; if the person has ≥1 phone, exactly one is primary. A boolean
//      column cannot see its siblings, so add auto-sets the first primary and
//      delete auto-promotes another.
//
// ownerUserId is a plain String for the same reason it is on Company: wiring it to
// User would add a back-relation to the protected model, and a nullable owner
// pointer needs no cascade.
// -----------------------------------------------------------------------------
model Person {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  firstName          String? // NULLABLE — see the identity-anchor rule (§5.15)
  lastName           String? // nullable: not every name splits into two parts
  preferredFirstName String? // nickname the dialer says, e.g. "Bob" for "Robert"
  title              String?
  linkedinUrl        String? // an identity anchor + enrichment/personalization key
  // Display name = preferredFirstName ?? firstName (+ lastName), else an email, else "Unknown".

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerUserId String?

  timeZone String? // IANA, for "is it a decent hour to call"

  // decision_maker | gatekeeper | champion | influencer | user | other
  persona String?

  // on_deck | on_hold | backburner | disqualified — a fixed system enum (§5.6a).
  attentionStatus String    @default("on_deck")
  attentionReason String?
  callbackDate    DateTime?

  source          String? // manual | import | enrichment | inbound_call | ...
  lastContactedAt DateTime?

  nameAudioUrl String? // clip of them saying their own name, played pre-ring — PHASE 2 fill

  customJson Json @default("{}")

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)
  isArchived   Boolean   @default(false)
  deletedAt    DateTime?

  phones              PersonPhone[]
  addresses           PersonEmail[] // the person's own email addresses, each with a status
  // This person's role on each deal they are on. A person can hold DIFFERENT roles
  // on DIFFERENT deals — champion on one, influencer on another (MAI-131 T3).
  dealRoles           DealPersonRole[]
  // Calls with this person (Call.personId → Person). SetNull on that side, so
  // deleting a person never destroys call history (MAI-132 T4).
  calls               Call[]
  // Call-speaker identity can point at this CRM person. SetNull on that side,
  // so the call's manual correction stays auditable if the person is deleted.
  callSpeakers        CallSpeaker[]
  // Every email this person was a from/to/cc/bcc on (EmailParticipant.personId →
  // Person). SetNull on that side: deleting a person leaves the participant row
  // and its RAW address intact, so the message still reads correctly (MAI-137 T9).
  emailParticipations EmailParticipant[]
  // Texts with this person (SmsMessage.personId → Person). SetNull on that side,
  // so deleting a person never destroys text history (MAI-138 T10).
  smsMessages         SmsMessage[]
  // Every meeting this person was invited to (MeetingAttendee.personId → Person).
  // SetNull on that side, exactly as EmailParticipant is: deleting a person leaves
  // the attendee row and its RAW email intact, so the invite still reads
  // correctly (MAI-139 T11).
  meetingAttendances  MeetingAttendee[]
  // Meetings this person organised (Meeting.organizerPersonId → Person). SetNull
  // on that side too — Meeting.organizerEmail is what the row falls back to.
  organizedMeetings   Meeting[]          @relation("MeetingOrganizer")
  // This person's feed (ActivityEntry.personId → Person). SetNull on that side
  // too, for the same reason (MAI-140 T12).
  activity            ActivityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, companyId])
  @@index([orgId, ownerUserId])
  @@index([orgId, attentionStatus])
  @@index([orgId, callbackDate])
}

// -----------------------------------------------------------------------------
// Dialable identity — one row per value, each with its own life story.
// -----------------------------------------------------------------------------

model PersonPhone {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  e164      String
  extension String?
  label     String  @default("other") // mobile | direct | work | main | home | other

  // Deliverability status — decays, re-verifiable. reachable | unverified | dead.
  status String  @default("unverified")
  // never_valid | no_longer_in_service | wrong_person — the reason behind "dead".
  reason String?

  // DNC is SEPARATE from status: legal, permanent, deliberate. Never fold into status.
  isDnc     Boolean @default(false)
  dncReason String?

  // mobile | landline | voip — Twilio Lookup. Blocks SMS to a landline; sorts dials.
  lineType          String?
  lineTypeCheckedAt DateTime?

  source    String? // manual | import | enrichment | inbound_call | ai_call
  isPrimary Boolean @default(false) // app-enforced: at most one true per person (§5.11)

  // Dial-order signals — cheap rollups written by the dialer; bestTimeToCall is a
  // nightly job (PHASE 2). Freshness is derived from lastDialedAt, not stored.
  timesDialed     Int       @default(0)
  lastDialedAt    DateTime?
  timesConnected  Int       @default(0)
  lastConnectedAt DateTime?
  bestTimeToCall  String? // morning | afternoon | evening | any — blank until enough data

  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, e164]) // re-adding the same number is idempotent
  @@index([orgId])
  @@index([orgId, e164])
  @@index([orgId, status])
}

model PersonEmail {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  address String
  label   String @default("work") // work | personal | other

  // Same shape as PersonPhone. reachable | unverified | dead.
  status String  @default("unverified")
  reason String? // hard_bounce | never_valid | wrong_person

  isDnc     Boolean @default(false) // e.g. unsubscribed — legal, separate from status
  dncReason String?

  source    String?
  isPrimary Boolean @default(false) // app-enforced: at most one true per person (§5.11)

  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, address]) // re-adding the same address is idempotent
  @@index([orgId])
  @@index([orgId, address])
}

// -----------------------------------------------------------------------------
// CRM — Deal spine (MAI-131, Phase 1 / T3). A Deal is one possible sale: pipeline,
// forecast, and the reason to call. Pipeline / PipelineStage configure the stages
// a deal moves through; DealPersonRole is the buying committee (multi-threading).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.4 typed FKs + a named join for an edge
// that carries data, §5.8 money as integer minor units). Plan: T3.
//
// Two rules the database CANNOT enforce, so they live in routes/deals.ts:
//   1. A Deal's stage must belong to the Deal's pipeline. stageId and pipelineId
//      are each a valid FK on their own, but "this stage is in that pipeline" is a
//      cross-row relationship no single FK can state.
//   2. Money is stored in integer minor units (BigInt), never a float — the route
//      accepts and returns it as an exact integer string so it round-trips with no
//      drift (§5.8).
//
// ownerUserId is a plain String, for the same reason it is on Company/Person:
// wiring it to User would add a back-relation to the protected model, and a
// nullable owner pointer needs no cascade.
// -----------------------------------------------------------------------------

// The ordered list of stages a deal moves through (e.g. "New Business": New →
// Qualified → Proposal → Won). Exactly one Pipeline per org is seeded later (T6);
// the model already supports a second (e.g. "Renewals") with no migration.
model Pipeline {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false)

  stages PipelineStage[]
  deals  Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}

// A saved report is the durable form of a reporting-engine config. The engine
// owns the config's shape; this model owns its lifecycle (MAI-145).
model Report {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Nullable + SetNull: reports are organization data and outlive a teammate's
  // departure. This first slice still filters My reports by the active owner.
  ownerId String?
  owner   User?   @relation("ReportOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  name       String
  kind       String @default("pivot") // pivot | activity | transition | cohort | dialer
  configJson Json

  // The trash is a soft delete. A later cleanup job may permanently purge rows
  // after 30 days, but this slice never destroys a report immediately.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("ReportDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, ownerId, deletedAt])
}

// Dialer-specific hourly aggregates (MAI-161). General activity metrics stay
// in ActivityEntry; these rows exist only for the number/area analytics that
// the general reporting slices do not model.
model AnalyticsRollup {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // UTC calendar day derived from the call instant. P2.6 will add the
  // organization-zone time-of-day dimension without rewriting this source data.
  day DateTime
  // Reserved for P2.6's hour-by-day heatmap. Null is this issue's daily rollup.
  hourOfDay Int?
  // The owned caller ID used for the outbound call.
  numberE164 String
  // The dialed prospect's North American area code, null for other numbering plans.
  areaCode String?
  dials    Int @default(0)
  connects Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, day, hourOfDay, numberE164, areaCode])
  @@index([orgId, numberE164])
  @@index([orgId, areaCode])
}

// One step in a Pipeline. winProbability weights the forecast; outcome tells the
// board which columns end the deal.
model PipelineStage {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  name           String
  color          String @default("#94a3b8")
  sortOrder      Int
  winProbability Int    @default(0) // 0..100, weights the forecast

  // open | won | lost — a fixed system enum. Which columns end the deal.
  outcome String @default("open")

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([pipelineId, sortOrder])
}

model Deal {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String

  // SetNull, not Cascade: trashing a company must not delete its deals.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // Which of the org's pipelines this ONE deal runs through. Restrict: a pipeline
  // still carrying a deal cannot be deleted out from under it.
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict)

  // The deal's current stage. Restrict for the same reason. App code guarantees
  // this stage belongs to `pipeline` — the DB cannot express that cross-row rule.
  stageId String
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)

  // Integer minor units (cents; JPY = whole yen), never a float (§5.8). Nullable
  // until a deal is sized. currency is ISO-4217.
  amountMinor BigInt?
  currency    String  @default("USD")

  closeDate DateTime?

  // open | won | lost — a fixed system enum (§5.6a).
  status     String  @default("open")
  lostReason String? // a user picklist; free text for now

  ownerUserId String?

  customJson Json @default("{}")

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)
  isArchived   Boolean   @default(false)
  deletedAt    DateTime?

  personRoles DealPersonRole[]
  // Calls logged against this deal (Call.dealId → Deal). SetNull on that side, so
  // deleting a deal never destroys call history (MAI-132 T4).
  calls       Call[]
  // Emails logged against this deal (Email.dealId → Deal). SetNull on that side
  // too, so deleting a deal never destroys message history (MAI-137 T9).
  emails      Email[]
  // Texts logged against this deal (SmsMessage.dealId → Deal). SetNull on that
  // side too, for the same reason (MAI-138 T10).
  smsMessages SmsMessage[]
  // Meetings logged against this deal (Meeting.dealId → Deal). SetNull on that
  // side too, for the same reason (MAI-139 T11).
  meetings    Meeting[]
  // The deal page's feed (ActivityEntry.dealId → Deal). SetNull on that side too,
  // for the same reason (MAI-140 T12).
  activity    ActivityEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, companyId])
  @@index([orgId, stageId])
  @@index([orgId, ownerUserId])
  @@index([orgId, closeDate])
}

// Salesforce's OpportunityContactRole: the buying committee. Named *Person*Role to
// match "Person" as the object name everywhere in this schema (§5.4). The
// @@unique([dealId, personId]) means a person appears at most ONCE per deal — but
// the SAME person can hold DIFFERENT roles on DIFFERENT deals (multi-threading).
model DealPersonRole {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // champion | decision_maker | economic_buyer | influencer | blocker | user | other
  role      String
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dealId, personId])
  @@index([orgId])
  @@index([personId])
}

// -----------------------------------------------------------------------------
// Schema-as-data (MAI-133 T5) — ObjectDef + AttributeDef describe BOTH the typed
// tables (Person/Company/Deal/...) and the generic Record rows. The UI, the field
// editor, validation, and views all read these rows and never care where a value
// physically sits (spec §5.1). Adding a custom FIELD is a row insert here, never a
// migration; adding a standard field is a real migration (§5.1, §5.6a).
// -----------------------------------------------------------------------------

// One row per object type in an org. Standard objects (person/company/deal/...)
// are seeded with isStandard=true and can be HIDDEN but never archived/deleted —
// the app's own code depends on them (§5.10, §10.2). Custom objects the user
// invents are storage="record" and live as Record rows (§5.1).
model ObjectDef {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  slug       String // person | company | deal | call | task | note | <custom>
  name       String // singular display label, e.g. "Company"
  namePlural String // e.g. "Companies" — navbar links, "+ New" buttons, table headers
  icon       String? // a lucide icon id, e.g. "building-2" (§9). Seeded for standard objects.
  iconColor  String? // optional tint for the icon, e.g. a purple custom object (§9)

  // "table"  = a real Postgres table; standard columns + customJson.
  // "record" = a Record row with valuesJson. Custom objects only.
  storage String @default("record")

  isStandard   Boolean @default(false) // app-seeded and app-depended-on
  isFirstClass Boolean @default(true) // gets a navbar link and a table
  // Custom records write account-timeline markers only when an administrator opts
  // this definition in. Off by default keeps generic record creation quiet.
  timelineEventsEnabled Boolean @default(false)

  isHidden   Boolean   @default(false)
  isArchived Boolean   @default(false)
  deletedAt  DateTime? // blocked when isStandard

  attributes AttributeDef[]
  savedViews SavedView[]
  detailLayouts DetailLayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
}

// One row per field on an object. type is a semantic type from §8's table; the
// value's physical home is `storage`: "column" (a real table column, always
// isSystem), "custom" (customJson/valuesJson), or "list" (ListEntry.valuesJson).
// isSystem fields can be renamed/hidden but never deleted or retyped (§10.2).
model AttributeDef {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  objectId String
  object   ObjectDef @relation(fields: [objectId], references: [id], onDelete: Cascade)

  slug        String
  name        String // display label shown in the UI, may differ from the slug
  description String? // one-line help text shown in the field editor / tooltip
  icon        String?

  // text | number | checkbox | date | timestamp | phone | email | url | domain
  // | select | multiselect | status | currency | rating | location
  // | person_name | record_reference | user_reference | ai   (full table in §8)
  type String

  optionsJson    Json? // select options: [{ value, label, color, order, isArchived }] (§5.6a)
  refObjectId    String? // for record_reference
  formatJson     Json? // display format (Sheets-style presets / custom mask)
  validationJson Json? // min/max/pattern/required-strict

  isIdentity Boolean @default(false) // a unique-to-one-entity field; drives dedupe

  // "column" = lives in a real column on the table (isSystem is always true here)
  // "custom" = lives in customJson / valuesJson
  // "list"   = lives in ListEntry.valuesJson
  storage String @default("custom")

  isMulti    Boolean @default(false)
  isRequired Boolean @default(false)
  isUnique   Boolean @default(false)
  isReadOnly Boolean @default(false)
  isSystem   Boolean @default(false) // rename/hide OK; delete and retype blocked

  defaultJson Json?
  sortOrder   Int   @default(0)

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([objectId, slug])
  @@index([orgId])
}

// A named, object-scoped arrangement of existing CRM data. This is presentation
// configuration only: it never owns records, attributes, or list membership.
// ownerUserId intentionally remains a plain id so a view can outlive its owner's
// account; access is checked against active Membership rows in SavedViewService.
model SavedView {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  objectId String
  object   ObjectDef @relation(fields: [objectId], references: [id], onDelete: Cascade)

  ownerUserId String
  name        String
  // list | grid | kanban. Kept as a String so a future layout is an additive migration.
  layout      String @default("grid")
  // Versioned, schema-validated presentation state; never a CRM record store.
  configJson  Json

  isShared  Boolean @default(false)
  // A system default is a recoverable service fallback, never a persisted row
  // that a user can delete. SavedViewService enforces that policy.
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)
  // Soft delete preserves the short undo window while leaving CRM data untouched.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, objectId, sortOrder])
  @@index([orgId, objectId, isShared])
  @@index([orgId, objectId, ownerUserId])
}

// One organization-wide record-page arrangement per object. The read route
// supplies a safe default until someone saves a custom arrangement.
model DetailLayout {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  objectId String
  object   ObjectDef @relation(fields: [objectId], references: [id], onDelete: Cascade)

  // [{ name, fields: [{ slug, width: 1 | 2 }], order }]
  sectionsJson    Json
  railObjectsJson Json?
  feedKindsJson   Json?
  isDefault       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, objectId])
  @@index([orgId])
}

// -----------------------------------------------------------------------------
// Custom objects (MAI-135 T7) — rows of user-invented objects (spec §5.1, §5.14).
//
// A custom ObjectDef has storage="record"; its rows live HERE, one per record,
// with every field packed into valuesJson keyed by AttributeDef slug. The typed
// core (Person/Company/Deal/...) does NOT use this — it uses real tables and real
// foreign keys. Every write into valuesJson goes through the one validator in
// server/src/crm/valuesValidator.ts, keyed on the object's AttributeDef rows:
// there are no ad-hoc JSON writes anywhere (spec §5.11, plan T7 risk "JSONB
// validation drift").
// -----------------------------------------------------------------------------

model Record {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The ObjectDef this row belongs to. A plain string, not a relation, matching
  // the spec: the row is generic and its shape is described by AttributeDef rows,
  // not by a foreign key. The route verifies the object is in this org on write.
  objectId String

  // { attributeSlug: value }. Empty means the key is ABSENT, never "" (spec §5.14).
  // Only the validator writes here.
  valuesJson Json @default("{}")

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, objectId])
  // GIN index for containment filters on valuesJson (@>). Generated natively by
  // Prisma (type: Gin), NOT hand-written SQL. JsonbPathOps is the smaller, faster
  // operator class for the containment queries the filter route uses (spec §5.1).
  @@index([valuesJson(ops: JsonbPathOps)], type: Gin)
}

// A reference that crosses into a custom object, or a note/task link to anything
// (spec §5.4). The core spine does NOT use this — it uses real foreign keys; this
// exists only for edges the typed columns cannot express.
model RecordLink {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The record this link starts from, and the AttributeDef slug when the link IS a
  // reference field (null for a bare note/task link). Object identifiers are slugs:
  // person | company | deal | note | task | <custom>.
  fromObject String
  fromId     String
  attribute  String?

  // The record this link points at.
  toObject String
  toId     String

  // Note/task link seam (spec §5.4), filled in by MAI-141 T13. This is THE way a
  // note or a task attaches to anything — there is deliberately no parallel
  // NoteLink/TaskLink table, because a second edge table is a second place for
  // "what is this attached to" to disagree with itself.
  //
  // The columns are redundant with (fromObject, fromId) on purpose, and the
  // redundancy is the point: fromObject/fromId is the GENERIC edge every custom
  // reference uses and cannot be a foreign key, while noteId/taskId ARE foreign
  // keys, so deleting a note takes its links with it (Cascade) instead of leaving
  // edges pointing at nothing. Writers set both halves; readers may use either.
  noteId String?
  note   Note?   @relation("NoteLinks", fields: [noteId], references: [id], onDelete: Cascade)
  taskId String?
  task   Task?   @relation("TaskLinks", fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, fromObject, fromId])
  @@index([orgId, toObject, toId])
  // "What is this note/task attached to" — the read a record page and a task card
  // both make, scoped by tenant.
  @@index([orgId, noteId])
  @@index([orgId, taskId])
}

// -----------------------------------------------------------------------------
// Field history and provenance (MAI-136 T8) — spec §5.7, impacts §D.
//
// FieldHistory answers "who changed what, when", and is written INSIDE the same
// transaction as the field change itself, so a value and its history can never
// disagree. It is append-only and is NEVER the source of truth: the current value
// stays a plain column read (that is 99% of queries, spec §5.7).
//
// Provenance is the TRUST seam for AI/enriched values: one row per written value,
// carrying source + confidence + evidence + the value it overwrote. It is what
// lets a scalar column carry "where did this come from / is it stale" without a
// per-field status column on every table (impacts B5/D1). Schema now; enrichment
// and the AI surfaces fill it in Phase 2.
// -----------------------------------------------------------------------------

model FieldHistory {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Which record the change landed on. Slug + id rather than a foreign key, so one
  // table covers every object — typed tables (person/company/deal) and custom
  // objects (Record rows) alike.
  objectSlug String // person | company | deal | <custom>
  recordId   String
  attribute  String // the AttributeDef slug that changed

  // A compact {old, new} pair, NOT a snapshot of the row (spec §5.7). Both are
  // nullable: a first write has no old value, a cleared field has no new one.
  // Shape is validated in app code against the attribute's declared type
  // (server/src/crm/fieldHistory.ts) — the database will not.
  oldJson Json?
  newJson Json?

  // Who/what made the change. changedByUserId is NULL for non-human changes;
  // changeSource then names the process (enrichment, an AI field, an import, a
  // workflow, a system job). TS union: ChangeSource in server/src/crm/fieldHistory.ts.
  changedByUserId String?
  changeSource    String  @default("user") // user | enrichment | ai | import | workflow | system
  reason          String? // optional why, e.g. "moved to Beta after the acquisition"

  changedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The one read this table exists for: "show me this record's history, newest first".
  @@index([orgId, objectSlug, recordId, changedAt])

  // Reporting asks the inverse question: which records changed this attribute in
  // a time range? `newJson` then narrows those indexed transition candidates to
  // the target stage (SPEC-REPORTING-ENGINE.md §3B-1 / MAI-159).
  @@index([orgId, objectSlug, attribute, changedAt])
}

model Provenance {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  objectSlug String // person | company | deal | <custom>
  recordId   String
  attribute  String // which field this value is for

  value         Json?
  previousValue Json? // kept so rejecting an AI value can revert it

  source          String // enrichment_provider | transcript_line | web_citation | chat | ai_field
  sourceRef       Json? // {url} | {callId,startMs} | {provider}
  evidenceSnippet String?
  confidence      Float?

  status   String    @default("unverified") // unverified | verified | rejected
  statusBy String?
  statusAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, objectSlug, recordId, attribute])
}

// -----------------------------------------------------------------------------
// Activities — Email + EmailParticipant + EmailAttachment (MAI-137, Phase 3 / T9).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.12 "email works even when nobody on it
// is in the CRM", §6). Plan: tasks/plan-crm-schema.md (T9).
//
// Same shape as Call: a real table, first-class from day 1, with nullable spine
// links so a message from total strangers still logs. Compose/send/sync journeys
// are a LATER spec — this is only the data those journeys will write into, plus
// the read routes over it (server/src/routes/emails.ts).
//
// THE CREDENTIAL BOUNDARY. Mail auth is owned by OAuthConnection (the encrypted
// grant) and MailAccount (the mailbox identity). Those two are the SINGLE source
// of truth, and NOTHING here duplicates them: this model holds no refresh token,
// no access token, no scopes, no secret, and no copy of the mailbox address. It
// points at a mailbox with one nullable foreign key and stops there.
// -----------------------------------------------------------------------------

// Email — a provider-agnostic superset of Gmail's Message and Microsoft Graph's
// message. The record does NOT carry a single personId: an email has MANY
// participants (from/to/cc/bcc), stored as EmailParticipant rows. That is exactly
// what lets us ingest or send email when nobody on it is in the CRM yet (§5.12).
// companyId/dealId ARE here — they are the account-level roll-ups the feed reads,
// and they mirror how Call was wired in T4 (nullable, onDelete: SetNull, so
// trashing a Company or Deal never destroys message history).
model Email {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // WHICH SYNCED MAILBOX this row came from — not "the sender", which is an
  // EmailParticipant with role "from". MailAccount is the mailbox model owned by
  // the Integration Hub; this is a pointer to it and nothing more.
  //
  // Nullable + onDelete: SetNull, deliberately, and NOT Cascade: a rep
  // disconnecting their mailbox must not delete the org's record of what was said.
  // The message survives with mailAccountId = null. Nullable also covers a row
  // written by something other than a mailbox sync (an import, a backfill).
  mailAccountId String?
  mailAccount   MailAccount? @relation(fields: [mailAccountId], references: [id], onDelete: SetNull)

  direction String // outbound | inbound
  subject   String?
  bodyHtml  String?
  bodyText  String? // plaintext part, also used for full-text search
  snippet   String? // Gmail snippet / Graph bodyPreview — the list-row preview

  // Threading — the cross-provider keys. internetMessageId (the RFC5322 Message-ID
  // header) is the one identifier that is stable across Gmail AND Graph AND plain
  // IMAP, which is why it is the dedupe key below. conversationId groups a chain.
  // REQUIRED (MAI-187): Originally nullable to allow partial syncs, but the unique
  // constraint on (orgId, mailAccountId, internetMessageId) only works if the field
  // is NOT NULL. For originated messages, a synthetic RFC5322 Message-ID is generated.
  internetMessageId String // RFC5322 Message-ID
  conversationId    String? // Gmail threadId / Graph conversationId
  inReplyTo         String?
  references        String[] @default([])

  importance     String  @default("normal") // low | normal | high
  isRead         Boolean @default(false)
  isDraft        Boolean @default(false)
  hasAttachments Boolean @default(false)

  // Provider bookkeeping for sync + deep-linking back to the source. All of it is
  // non-secret: ids, labels, a link, a change marker. No token ever lands here.
  provider          String? // gmail | m365 | imap
  providerMessageId String? // Gmail id / Graph id (per-mailbox; changes on move in Graph)
  providerThreadId  String?
  folderOrLabels    String[] @default([]) // Gmail labelIds / Graph parentFolderId path
  webLink           String? // "open in Gmail/Outlook"
  syncCursor        String? // Gmail historyId / Graph changeKey, for delta sync

  sentAt     DateTime?
  receivedAt DateTime?

  participants EmailParticipant[]
  attachments  EmailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // IDEMPOTENT RE-SYNC. Re-reading the same message from the same mailbox hits
  // this key and updates instead of inserting a duplicate. Keyed on the MAILBOX
  // (mailAccountId), not on the mailbox's owner: one rep can connect two mailboxes,
  // and the same Message-ID legitimately appears in both — they are two rows,
  // because two people were sent it. Postgres allows many NULLs under a unique
  // index, so rows with no Message-ID yet (a local draft, a partial sync) do not
  // collide with each other.
  @@unique([orgId, mailAccountId, internetMessageId])
  @@index([orgId])
  // The hot paths: the org's message list newest-first, and the same list narrowed
  // to one account or one deal — the Company/Deal feed in one indexed round-trip.
  @@index([orgId, sentAt])
  @@index([orgId, companyId, sentAt])
  @@index([orgId, dealId, sentAt])
  // "Show me the rest of this thread."
  @@index([orgId, conversationId])
}

// One address on an email. THE ADDRESS IS ALWAYS KEPT RAW, and personId is
// NULLABLE: a participant who is not (yet) in the CRM is stored as a plain
// name + address, and a later match writes personId on THIS row — the email
// itself is never rewritten, and the address it was actually sent to never
// changes. onDelete: SetNull on the person side, for the same reason: deleting a
// Person unlinks, it does not erase who was on the message.
model EmailParticipant {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  emailId String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  role    String // from | sender | to | cc | bcc | reply_to
  name    String?
  address String // the RAW email address, exactly as it appeared on the message

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, emailId])
  // The match path: "which unlinked participants have this address?"
  @@index([orgId, address])
  @@index([personId])
}

// One attachment on an email. storageUrl is the seam to our own copy: it holds a
// bare S3 object KEY, not a link a browser can open — the read route presigns it
// at request time, exactly as Call.recordingUrl does. Null until the download job
// runs, so the row exists (and the list can say "2 attachments") before the bytes
// are ours.
model EmailAttachment {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  emailId String
  email   Email  @relation(fields: [emailId], references: [id], onDelete: Cascade)

  filename    String?
  contentType String? // the MIME type, e.g. "application/pdf"
  sizeBytes   Int?
  isInline    Boolean @default(false)
  contentId   String? // cid: for inline images referenced from bodyHtml

  storageUrl           String? // our S3 object key (null until the download job runs)
  providerAttachmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, emailId])
}

// -----------------------------------------------------------------------------
// Activities — SmsMessage + MessageMedia (MAI-138, Phase 3 / T10).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md §6. Plan: tasks/plan-crm-schema.md (T10).
//
// Same shape as Call and Email: a real table, first-class from day 1, with
// nullable spine links so an inbound text from a number nobody has ever heard of
// still logs. Sending, and the Twilio inbound/status webhooks that will write
// these rows, are a LATER spec — this ticket lands the tables and the read routes
// over them (server/src/routes/messages.ts).
//
// THE VOICE BOUNDARY. Call and PhoneNumber are the dialer's models and NOTHING
// here changes them. `phoneNumberId` below is deliberately a bare id column with
// no Prisma relation: a relation would need a back-relation array on PhoneNumber,
// and text history has no business editing the dialer's model to exist. The spec
// writes it the same way (§6).
// -----------------------------------------------------------------------------

// SmsMessage — a superset of Twilio's Message resource. Handles SMS and MMS, and
// leaves room for RCS and WhatsApp, which differ from SMS in `channel` and in
// what hangs off MessageMedia rather than in the shape of a message.
//
// Unlike Email there IS a single personId here, and that is not an inconsistency:
// a text has exactly two endpoints, so "who was this with" is one person. It is
// NULLABLE, which is the whole point — an inbound text from an unknown number
// logs with every spine link null, and a later number→person match fills it in
// without rewriting what was said. onDelete: SetNull on all three, never Cascade:
// trashing a Person, Company, or Deal must not destroy text history.
model SmsMessage {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // The rep whose number sent or received it. Nullable + SetNull, not Restrict as
  // Call.userId is: a text can arrive on an org-owned number that belongs to
  // nobody in particular, and deleting a rep must leave the org's record standing.
  mailboxUserId String?
  mailboxUser   User?   @relation("SmsMailbox", fields: [mailboxUserId], references: [id], onDelete: SetNull)

  // Which of our PhoneNumber rows sent or received it. A bare id, no relation —
  // see THE VOICE BOUNDARY above.
  phoneNumberId String?

  // E.164 both sides, kept RAW for the same reason EmailParticipant.address is:
  // it is what was actually on the message, and a personId is a link we drew
  // later. A text from a stranger renders from these two alone.
  fromE164 String
  toE164   String

  // Allowed values: "outbound", "inbound".
  direction String

  body String?

  // Twilio's Message status, verbatim. Allowed values: "queued", "sending",
  // "sent", "delivered", "undelivered", "failed", "received". "received" is the
  // inbound terminal state; the rest are the outbound lifecycle.
  status       String  @default("queued")
  errorCode    String? // Twilio's numeric code, kept as text — it is an identifier, not a number we do arithmetic on
  errorMessage String?

  // Billing/segmentation facts from Twilio. numMedia is a COUNT Twilio reports,
  // and the MessageMedia rows are the media themselves: the count arrives on the
  // webhook before the media have been fetched, so the two are not redundant.
  numSegments Int?
  numMedia    Int  @default(0)

  // Allowed values: "sms", "mms", "rcs", "whatsapp". Media for any of them hangs
  // off MessageMedia, so gaining a channel does not change this table's shape.
  channel String @default("sms")

  // Twilio bookkeeping. twilioSid is UNIQUE so a re-delivered webhook — Twilio
  // retries, and it does so with the same SID — upserts instead of logging the
  // text twice. Postgres allows many NULLs under a unique index, so rows written
  // before Twilio has accepted the message do not collide.
  twilioSid           String? @unique
  messagingServiceSid String?
  price               String? // Twilio sends this as a decimal STRING; storing it as one keeps it exact
  priceUnit           String? // the ISO currency of `price`, e.g. "USD"

  media MessageMedia[]

  // Two timestamps, because they are two different facts: sentAt is when it left,
  // deliveredAt is when the carrier confirmed it landed. An undelivered message
  // has the first and not the second, and that gap IS the delivery failure.
  sentAt      DateTime?
  deliveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  // The hot paths: a Person/Company/Deal page loads its recent texts in one
  // indexed round-trip, newest first — the same three the call history has.
  @@index([orgId, personId, sentAt])
  @@index([orgId, companyId, sentAt])
  @@index([orgId, dealId, sentAt])
  // The inbound-match path: "which of our numbers was this sent to?"
  @@index([orgId, toE164])
}

// MMS / image / video / audio attached to a message. ONE shape for every media
// type, so supporting MMS photos today and voice notes later is a contentType,
// not a migration.
//
// storageUrl holds a bare S3 object KEY, not a link a browser can open, exactly
// as Call.recordingUrl and EmailAttachment.storageUrl do. Null until the fetch
// job has run — and that job is not optional bookkeeping: Twilio PURGES its own
// media copies, so the row exists (and the list can say "2 images") before the
// bytes are ours, and our copy is the only one that lasts.
model MessageMedia {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  smsMessageId String
  message      SmsMessage @relation(fields: [smsMessageId], references: [id], onDelete: Cascade)

  contentType    String // the MIME type, e.g. "image/jpeg", "video/mp4", "audio/ogg"
  storageUrl     String? // our S3 object key (null until the fetch job runs)
  twilioMediaSid String?
  sizeBytes      Int?

  // Which position this media held on the message. Twilio numbers the webhook
  // params MediaUrl0, MediaUrl1, … and an MMS with two images is two images IN AN
  // ORDER; without this the rows come back in whatever order the database likes.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, smsMessageId])
}

// -----------------------------------------------------------------------------
// Activities — Meeting + MeetingAttendee (MAI-139, Phase 3 / T11).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md §6. Plan: tasks/plan-crm-schema.md (T11).
//
// Same shape as Call, Email, and SmsMessage: real tables, first-class from day 1,
// with nullable spine links so a meeting with people nobody has ever added to the
// CRM still logs. Calendar sync — the Google Calendar and Microsoft Graph pull
// that will WRITE these rows — is a LATER spec; this ticket lands the tables and
// the read routes over them (server/src/routes/meetings.ts).
//
// THE CREDENTIAL BOUNDARY, again. Calendar auth is OAuthConnection's (the
// encrypted grant), owned by the Integration Hub, and NOTHING here duplicates it:
// no refresh token, no access token, no scope, no secret. A Meeting does not even
// carry an account foreign key — see the note on `provider` below for why the
// dedupe key deliberately stops at (org, provider, event).
// -----------------------------------------------------------------------------

// Meeting — a superset of Google Calendar's Event and Microsoft Graph's event,
// plus a seam for meeting-intelligence providers (recall.ai / Gong).
//
// THE POINT OF THIS MODEL, and an explicit acceptance criterion: `location` and
// `joinUrl` are TWO COLUMNS. A physical room is not a video link. Collapsing them
// into one "where" string is the mistake every calendar integration makes once:
// it makes "which meetings are in person?" unanswerable, it puts a URL in the
// field a map would render, and it loses the room the moment a Meet link is
// added. Google keeps them apart too (`location` vs `hangoutLink` /
// `conferenceData`), and so does Graph (`location` vs `onlineMeeting.joinUrl`).
// A meeting can have BOTH (a room with a dial-in), EITHER, or NEITHER.
//
// Like Email, the record does NOT carry a single personId: a meeting has MANY
// attendees, stored as MeetingAttendee rows. `organizerPersonId` is the one
// person link, because a meeting has exactly one organizer. companyId/dealId ARE
// here — they are the account-level roll-ups the feed reads, mirroring Call,
// Email, and SmsMessage (nullable, onDelete: SetNull, so trashing a Company or
// Deal never destroys meeting history).
model Meeting {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  title       String
  description String?

  // WHERE IT HAPPENS — two facts, two columns, on purpose (see above).
  location           String? // free-text physical location, e.g. "HQ, Room 4"
  joinUrl            String? // the video link: Meet hangoutLink / Zoom / Teams joinUrl
  // Allowed values: "google_meet", "zoom", "teams", "other". Null when there is
  // no video link at all — an in-person meeting is not a conference with an
  // unknown provider.
  conferenceProvider String?

  // WHEN IT HAPPENS. isAllDay is the switch between two genuinely different
  // things, and it is why this is a boolean and not an inference from the times:
  //
  //   - A TIMED meeting is an instant. startsAt/endsAt are stored in UTC (Prisma
  //     writes UTC) and `timeZone` carries the IANA zone the event was BOOKED in,
  //     so a client can render "Jun 24, 2026, 6:00 PM EDT" with a real zone label
  //     rather than guessing (CLAUDE.md → Dates & Times).
  //   - An ALL-DAY meeting is a CALENDAR DATE, not an instant. Google sends
  //     `start.date` = "2026-08-25" with no time and no zone; Graph sends
  //     isAllDay with midnight boundaries. We store the UTC midnight of that
  //     date, and the date is read back off the UTC parts — which is exactly why
  //     an all-day value must be rendered with NO time and NO zone. Rendering it
  //     in a viewer's zone is what turns "Aug 25" into "Aug 24, 8:00 PM" for
  //     anyone west of UTC. server/src/crm/meetingActivity.ts holds that rule at
  //     the API boundary so no client has to remember it.
  //
  // endsAt is EXCLUSIVE for an all-day event, matching Google: a one-day meeting
  // on the 25th ends on the 26th.
  isAllDay Boolean  @default(false)
  startsAt DateTime
  endsAt   DateTime
  timeZone String? // IANA, e.g. "America/New_York". Null on an all-day event.

  // Allowed values: "confirmed", "tentative", "cancelled". A cancelled meeting is
  // KEPT, not deleted: "they cancelled" is a fact about the account.
  status String @default("confirmed")

  // The organizer. The RAW email is always kept, for the same reason
  // EmailParticipant.address is: it is who actually convened the meeting, and a
  // personId is a link we drew later. SetNull, so deleting the Person unlinks
  // without erasing who called the meeting.
  organizerEmail    String?
  organizerPersonId String?
  organizerPerson   Person? @relation("MeetingOrganizer", fields: [organizerPersonId], references: [id], onDelete: SetNull)

  // Calendar-sync bookkeeping. All of it non-secret: ids, a link, a change
  // marker. No token ever lands here.
  //
  // Allowed values for `provider`: "google", "m365", "manual".
  provider         String?
  providerEventId  String? // Google event id / Graph event id
  iCalUid          String? // the stable cross-provider id, shared by every attendee's copy
  recurringEventId String? // the series this instance belongs to
  syncCursor       String? // Google etag / Graph changeKey, for delta sync
  webLink          String? // htmlLink — "open in Google Calendar / Outlook"

  // Meeting-intelligence seam (recall.ai / Gong) — PHASE 2 fill. recordingUrl
  // holds a bare S3 object KEY, not a link a browser can open, exactly as
  // Call.recordingUrl, EmailAttachment.storageUrl, and MessageMedia.storageUrl
  // do; the read route presigns it when the bytes are ours.
  //
  // Allowed values for `recordingProvider`: "recall_ai", "gong", "zoom".
  // Allowed values for `transcriptStatus`: "pending", "done", "failed".
  recordingUrl        String?
  recordingProvider   String?
  transcriptStatus    String?
  externalRecordingId String?

  attendees MeetingAttendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // IDEMPOTENT RE-SYNC — the acceptance criterion. Re-reading the same calendar
  // event hits this key and updates instead of inserting a second copy.
  //
  // Keyed on (org, provider, event) and deliberately NOT on a connected account:
  // when two reps in one org are both on the same meeting, Google hands each of
  // their calendars the SAME event id, and that is ONE meeting, not two. Email is
  // keyed the other way (per mailbox) because two mailboxes receiving one message
  // genuinely are two received messages. Postgres allows many NULLs under a
  // unique index, so hand-created meetings — provider "manual" with no event id,
  // or no provider at all — never collide with each other.
  @@unique([orgId, provider, providerEventId])
  @@index([orgId])
  // The hot paths: the org's calendar in a date window, and the same window
  // narrowed to one account or one deal — a Company/Deal feed in one indexed
  // round-trip.
  @@index([orgId, startsAt])
  @@index([orgId, companyId, startsAt])
  @@index([orgId, dealId, startsAt])
  // "Is this the same event we already have from the other provider?" — the
  // cross-provider dedupe path.
  @@index([orgId, iCalUid])
}

// One invitee on a meeting. THE EMAIL IS ALWAYS KEPT RAW, and personId is
// NULLABLE — that pair IS the acceptance criterion, and it is the same rule
// EmailParticipant holds to (§5.12).
//
// An external attendee is a real, common case: a customer's lawyer forwarded the
// invite, a candidate's partner joined, a vendor's SE was added by the customer.
// None of them should be conjured into the org's People list — that would flood
// it with one-off invitees, and "who are our contacts" would stop meaning
// anything. The record-creation setting (spec §5.3a) decides IF and WHEN an
// attendee becomes a Person; until then this row still holds their email, which
// is everything a later match or enrichment needs.
//
// onDelete: SetNull on the person side, for the same reason: deleting a Person
// unlinks, it does not erase who was in the room.
model MeetingAttendee {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  name  String?
  email String // the RAW address, exactly as it appeared on the invite

  personId String?
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  // Allowed values: "needs_action", "accepted", "declined", "tentative" — Google's
  // responseStatus vocabulary, which Graph's response types map onto.
  responseStatus String  @default("needs_action")
  isOrganizer    Boolean @default(false)
  // Optional attendee vs required. Google marks it on the attendee; Graph has a
  // "optional" attendee type. It is not a nicety: "the decision maker was
  // optional" is a different meeting from "the decision maker was required".
  isOptional     Boolean @default(false)
  // A room or a piece of equipment, not a person. Both providers put rooms in the
  // attendee list, and a room that accepted is a booked room — but it must never
  // be counted as a human, matched to a Person, or emailed.
  isResource     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per address per meeting. Re-syncing the same event updates each
  // attendee in place instead of appending a second copy of everyone.
  @@unique([meetingId, email])
  @@index([orgId, meetingId])
  // The match path: "which unlinked attendees have this address?"
  @@index([orgId, email])
  @@index([personId])
}

// -----------------------------------------------------------------------------
// Activities — ActivityEntry, the denormalized feed (MAI-140, Phase 3 / T12).
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md §5.11a / §6. Plan: tasks/plan-crm-schema.md
// (T12). CHECKPOINT C.
//
// This table exists for ONE reason: an account page's "everything that happened
// here" list must be a SINGLE indexed query. Without it, that list is a UNION
// across Call, Email, SmsMessage, Meeting, Note and (later) stage changes —
// five sorted reads merged in application memory, re-paginated by hand, growing
// a sixth branch every time the product learns a new kind of activity. With it,
// the feed is `WHERE (orgId, companyId) ORDER BY occurredAt DESC LIMIT n` against
// a composite index, with NO joins at all.
//
// THE COST OF THAT IS DUPLICATION, and duplication is only safe when it cannot
// drift. Two rules make it safe, and both are enforced rather than documented:
//
//   1. A feed row is written in the SAME TRANSACTION as the activity it
//      summarizes. server/src/crm/activityFeed.ts accepts only a
//      Prisma.TransactionClient, exactly as fieldHistory.ts does, so writing one
//      outside the activity's own transaction is a TYPE ERROR. Either both rows
//      commit or neither does — the feed can never claim a call that rolled back.
//   2. `@@unique([orgId, sourceType, sourceId])` makes a re-save UPDATE the one
//      row rather than append a second. Both key columns are NON-NULL for that
//      reason: Postgres treats NULLs as distinct in a unique index, so a nullable
//      column silently turns a unique constraint into no constraint at all.
//
// THIS TABLE IS NEVER THE SOURCE OF TRUTH. It is a cache of rows that live
// elsewhere. Nothing reads it to answer "what did that call cost" or "who was on
// that email" — `sourceType` + `sourceId` point at the real row for that. Deleting
// the underlying activity is expected to delete its feed row; the spine links are
// SetNull, so trashing a Company unlinks the feed row without erasing the history
// of what happened.
// -----------------------------------------------------------------------------
model ActivityEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // --- What this row summarizes ----------------------------------------------
  // Allowed values: "call", "email", "sms", "meeting", "note", "stage_change",
  // "task", "record_created", and "custom". A String, never a Prisma enum: this
  // list grows with timeline sources and Postgres enums require an ALTER TYPE dance.
  // A String, not a Prisma enum, because this list WILL gain values and a Postgres
  // enum needs an ALTER TYPE dance to do it (.claude/rules/database-and-prisma.md
  // → No Enums). The type-safe half is ACTIVITY_SOURCE_TYPES in
  // server/src/crm/activityFeed.ts.
  //
  // NOT NULL, and neither is sourceId — see rule 2 in the block comment above.
  sourceType String
  // The id of the real Call / Email / SmsMessage / Meeting / Note row. Deliberately
  // NOT a foreign key: one column cannot point at six tables, and a polymorphic FK
  // per source would be six nullable columns and six indexes to keep in step.
  sourceId   String

  // --- What the feed renders, without a join ---------------------------------
  // The whole point of the denormalization: a feed row paints itself. `summary` is
  // the short cached line ("Called +12025550123 — 4m 12s"); `preview` is the
  // optional snippet under it (an email's first line, a text's body). Both are
  // WRITE-TIME captures, so editing the underlying row does not silently rewrite
  // history unless the writer re-saves and the upsert refreshes them.
  summary String
  preview String?

  // --- Versioned account-timeline projection --------------------------------
  // The generic CRM activity feed remains on summary/preview. These fields are the
  // timeline's durable row-level projection: it can render the title, bubble
  // weight, lane labels, and deal-ribbon metadata without joining every source.
  // The writer validates this v1 shape in crm/activityFeed.ts before every upsert.
  timelineVersion   Int    @default(1)
  timelineTitle     String
  // Allowed values are the TimelineEventSubtype TypeScript string union. NULL means
  // the source has no meaningful subtype; this is deliberately not a Prisma enum.
  timelineSubtype   String?
  // 1..5. One is a low-weight lifecycle marker; five is the strongest activity.
  timelineIntensity Int    @default(2)
  // { actorName?, companyName?, personName?, dealName? }; display snapshots avoid
  // per-event joins for timeline lanes and rows. JSON keeps the projection additive.
  timelineDisplay   Json?
  // Optional { type, before?, after? } deal ribbon marker. `type` is a TypeScript
  // string union (deal_created | stage_moved | closed_won | closed_lost), not enum.
  timelineMarker    Json?

  // Allowed values: "outbound", "inbound", or NULL where the idea does not apply
  // (a note has no direction, and neither does a stage change).
  direction String?

  // --- Ordering ---------------------------------------------------------------
  // When the activity HAPPENED, which is not when the row was written: a calendar
  // sync backfills last week's meetings today, and the feed must still place them
  // last week. Every index below ends on this column because every read of this
  // table is "newest first" within a scope.
  occurredAt DateTime

  // --- Who did it -------------------------------------------------------------
  // The "just my activity" filter. Nullable because plenty of activity has no
  // internal actor at all — an inbound text, a synced meeting somebody else
  // organised. SetNull so deleting a user never destroys the org's record of what
  // happened; the summary still reads correctly without them.
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  // --- The spine links: the reason this is one query --------------------------
  // All three nullable, all three SetNull. A feed row for a call from an unknown
  // number carries no links and still logs; trashing a Company unlinks its feed
  // rows rather than deleting the fact that the calls happened.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  personId  String?
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency. One feed row per source row, forever: a re-sync, a retried job, or
  // a webhook delivered twice updates this row instead of appending a duplicate.
  // Both key columns are NOT NULL, which is what makes the constraint bite.
  @@unique([orgId, sourceType, sourceId])
  // The account-page feeds. Each one is (tenant, scope, time) so the read is an
  // index range scan in exactly the order it is returned — no sort, no join, no
  // union. These three ARE the acceptance criterion.
  @@index([orgId, companyId, occurredAt])
  @@index([orgId, personId, occurredAt])
  @@index([orgId, dealId, occurredAt])
  // "Just my activity", org-wide.
  @@index([orgId, createdByUserId, occurredAt])
  // The unscoped org feed — "what happened today" with no account chosen.
  @@index([orgId, occurredAt])
}

// -----------------------------------------------------------------------------
// Notifications — one event object, then one private lifecycle row per recipient.
//
// NotificationObject is the durable, deduplicated actor/verb/object event. It is
// intentionally separate from Notification so every recipient can independently
// read, archive, or snooze the same event without changing anyone else's inbox.
// `sourceSnapshot` is the narrowly-shaped safe fallback rendered when the source
// no longer exists or is unavailable; its exact accepted shape is enforced by
// server/src/crm/notifications.ts before it reaches this JSON column.
// -----------------------------------------------------------------------------
model NotificationObject {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // A deterministic, server-derived key. A retry of the same event upserts this
  // object instead of creating another fan-out batch.
  eventKey String

  // The source actor. SetNull preserves the notification event if an account is
  // removed; the writer only accepts an active member as the initial actor.
  actorUserId String?
  actor       User?   @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Validated strings, never Prisma enums. `verb` names what happened; the typed
  // object pair is the source contract that later resolves a deep-link destination.
  verb       String
  objectType String
  objectId   String

  // Exactly { title: string, preview?: string | null }, validated and normalized
  // by the event writer. It must remain safe to render after the live source is
  // deleted or access-checked as unavailable.
  sourceSnapshot Json

  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, eventKey])
  @@index([orgId, actorUserId])
  @@index([orgId, objectType, objectId])
}

model Notification {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  notificationObjectId String
  notificationObject   NotificationObject @relation(fields: [notificationObjectId], references: [id], onDelete: Cascade)

  recipientUserId String
  recipient       User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  // Recipient-owned lifecycle state. Null means unread, active, or not snoozed.
  readAt       DateTime?
  archivedAt   DateTime?
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Retrying the same event can never give one person two inbox rows.
  @@unique([notificationObjectId, recipientUserId])
  // All inbox views start with tenant and recipient, then use lifecycle state and
  // newest-first pagination.
  @@index([orgId, recipientUserId, archivedAt, snoozedUntil, createdAt])
  @@index([orgId, recipientUserId, readAt])
}

// -----------------------------------------------------------------------------
// Work — Task and Note (MAI-141 T13) — spec §6, impacts §J.
//
// The two halves of "what a rep still has to do" and "what a rep remembers".
// Both are FIRST-CLASS objects with their own tables, not attributes hung off a
// Person: a task belongs to the person doing it as much as to the record it is
// about, and a note routinely belongs to several records at once.
//
// THEIR LINKS RIDE ON RecordLink, and that is the whole design decision here.
// T7 added nullable `noteId`/`taskId` to RecordLink as exactly this seam. A note
// attached to a company, two people, and a deal is FOUR RecordLink rows — one
// generic edge table, so "what is attached to this record" stays ONE query no
// matter what kind of thing is attached. A dedicated NoteLink/TaskLink table
// would have been a second answer to that question, and two answers to a
// question about attachment is how a record page starts missing things.
//
// Neither model carries personId/companyId/dealId columns. That is not an
// oversight: a note links to MANY records (the T13 acceptance criterion), and a
// nullable triple of columns can hold exactly one of each, so it would quietly
// cap the thing the ticket exists to make possible.
// -----------------------------------------------------------------------------

model Task {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  title String
  body  String?

  // Allowed values: "call", "email", "todo". A String, not a Prisma enum — this
  // list gains values (sms, linkedin, …) and a Postgres enum needs an ALTER TYPE
  // dance to gain one (.claude/rules/database-and-prisma.md → No Enums). The
  // type-safe half is TASK_TYPES in server/src/crm/taskNote.ts.
  type       String @default("todo")
  // Allowed values: "low", "med", "high".
  priority   String @default("med")
  // Allowed values: "hard" (an appointment — a time someone else is holding) or
  // "soft" (a reminder — a time only this rep is holding). Two DIFFERENT promises,
  // which is why this is not folded into `priority`: a low-priority appointment is
  // still an appointment, and moving it costs somebody else their afternoon.
  commitment String @default("soft")

  // Nullable + SetNull: an unassigned task is a real state (a queue nobody has
  // picked up), and deleting a user must never delete the org's open work.
  assigneeUserId String?
  assignee       User?   @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  // When it is due, and when to nudge. Two columns, because "remind me an hour
  // before" is a different fact from "it is due at 4".
  dueAt    DateTime?
  remindAt DateTime?

  // Two-way link to a calendar event, and where this task CAME FROM.
  //
  // `origin` is the T13 acceptance criterion: a task derived from a calendar
  // event must stay distinguishable from one a rep typed, forever — a calendar
  // re-sync may rewrite the first and must never touch the second. Allowed
  // values: "manual", "calendar".
  //
  // `eventId` is a plain nullable String, NOT a foreign key to Meeting: the event
  // a task was derived from may not be synced into Meeting at all (or may be
  // deleted from the calendar later), and a task that vanishes because its event
  // did would lose work a rep still has to do. Task and Meeting stay
  // distinct-but-linked objects (spec §6, impacts 7b.13).
  eventId String?
  origin  String  @default("manual")

  // Done is a pair, not a flag: `isDone` is what a list filters on and `doneAt` is
  // when it happened, which is what a "completed this week" view reads. Setting
  // one without the other is the bug this comment exists to prevent — the route is
  // the one place that writes them, and it writes them together.
  isDone Boolean   @default(false)
  doneAt DateTime?

  // Soft delete into the 30-day trash (spec §5.13). deletedById is who binned it,
  // kept as a plain String rather than a relation so it survives that user being
  // deleted — the audit answer must outlive the account.
  deletedAt   DateTime?
  deletedById String?

  links RecordLink[] @relation("TaskLinks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  // "My open work" — the query behind every task list a rep opens.
  @@index([orgId, assigneeUserId, isDone])
  // "What is due" — the org-wide due-date sweep and the reminder job.
  @@index([orgId, dueAt])
  // Calendar reconciliation: find the task derived from THIS event, and find every
  // calendar-derived task in one scan without touching the hand-made ones.
  @@index([orgId, origin, eventId])
}

model Note {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The TipTap document — the note as it is edited and rendered. JSONB, because
  // rich text is a tree and flattening it to a string to store it would throw away
  // the formatting the rep applied.
  bodyJson Json
  // The same document flattened to plain text, for search and for the feed line.
  // DERIVED, never supplied: server/src/crm/taskNote.ts flattens bodyJson and the
  // route writes both together, so the searchable text and the rendered document
  // cannot describe different notes (CLAUDE.md → AI drafting, same rule).
  bodyText String

  // Nullable + SetNull, for the same reason Task.assigneeUserId is: deleting the
  // rep who wrote it must not delete the org's memory of what was said.
  authorUserId String?
  author       User?   @relation("NoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  links RecordLink[] @relation("NoteLinks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  // "Notes I wrote", newest first.
  @@index([orgId, authorUserId, createdAt])
}

// -----------------------------------------------------------------------------
// Lists — List and ListEntry (MAI-142 T14) — spec §5.3, §6, impacts §K.
//
// Attio's model, and the reason this schema has no Lead object (spec §5.2): a
// PROCESS lives on a list, not in a second person-shaped table. "Q3 outbound
// blitz" is a List of people; a person's position in that blitz is a ListEntry.
//
// TWO RULES THE TABLES THEMSELVES CARRY:
//
//   1. ONE OBJECT TYPE PER LIST. `List.objectSlug` says which object the list
//      holds — person, company, deal, or a custom object's slug — and every
//      entry's `objectSlug` is copied from the LIST, never taken from the
//      request. A list of companies with a person on it is a list whose columns
//      mean nothing on half its rows, and whose "add to list" screen cannot know
//      what to search. The route rejects the mismatch; see server/src/routes/lists.ts.
//   2. ENTRY VALUES ARE THE LIST'S, NOT THE RECORD'S. `valuesJson` holds the
//      values that belong to being ON THIS LIST — stage in this campaign, call
//      attempts in this blitz, priority for this push — described by AttributeDef
//      rows with storage="list" (which server/src/routes/records.ts already
//      excludes from a record's own values). Writing them touches no record, so
//      the same person can sit at "contacted" on one list and "untouched" on
//      another without either fact leaking onto the Person row everyone else reads.
//
// The `@@unique([listId, objectSlug, targetId])` below is what makes "add to
// list" idempotent. ALL THREE COLUMNS ARE NON-NULL, deliberately: Postgres treats
// NULLs as distinct in a unique index, so one nullable column silently turns this
// constraint off and the same record lands on the list twice (MAI-187 is exactly
// that bug, on Email). There is no nullable column in this key and none may be
// added to it.
// -----------------------------------------------------------------------------

model List {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name String
  // Stable, url-safe identity, unique per org. Derived from the name at create
  // when the caller does not supply one, and never patchable afterwards: a slug
  // that moves is a saved link that stops resolving.
  slug String

  // Which object this list holds: person | company | deal | <custom slug>. Set at
  // create and NEVER patchable — see rule 1 in the block above. Verified against
  // an ObjectDef in this org, so a typo is a 422 and not a list nothing can join.
  objectSlug String

  // What the list is for, and how it shows up in the sidebar. Both optional; the
  // icon is a lucide id, the same vocabulary ObjectDef.icon speaks (spec §10).
  description String?
  icon        String?

  // Who runs this list. A plain nullable String, not a relation, for the reason
  // Task.deletedById is one: the list outlives the account that owned it.
  ownerUserId String?

  // Sharing and sidebar order are properties of the list itself, never of a
  // membership entry. `sortOrder` has a stable default so lists created before
  // a user reorders them remain queryable with the same indexed shape.
  isShared  Boolean @default(false)
  sortOrder Int     @default(0)

  isArchived Boolean   @default(false)
  // Soft delete into the 30-day trash (spec §5.13).
  deletedAt  DateTime?

  entries ListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  // "The lists of people", "the lists of companies" — the sidebar's own query.
  @@index([orgId, objectSlug])
  // Shared-list sidebar lookup in its persisted order.
  @@index([orgId, objectSlug, isShared, sortOrder])
}

model ListEntry {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  // The record this entry points at. `objectSlug` ALWAYS equals the parent
  // List.objectSlug — it is copied from the list on write, never read from the
  // request — and is stored here anyway so "which lists is this record on" is one
  // indexed lookup instead of a join back through List.
  objectSlug String
  targetId   String

  // Entry-only values: stage in THIS process, attempt count, blitz priority.
  // Described by AttributeDef rows whose storage is "list", and written ONLY
  // through server/src/crm/valuesValidator.ts — the same one validator every other
  // custom value goes through, so a cleared value is stored ABSENT and never ""
  // (spec §5.14). Nothing here touches the underlying record.
  valuesJson Json @default("{}")

  // Manual ordering within the list. Nullable: most lists are sorted by a column,
  // and a null position means "this list has never been hand-ordered", which is a
  // different fact from "this row is at position 0".
  position      Int?
  addedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The same record cannot be added to one list twice. Every column here is
  // NON-NULL on purpose — see the block above this model.
  @@unique([listId, objectSlug, targetId])
  @@index([orgId])
  // The list's own page, in hand-order.
  @@index([orgId, listId, position])
  // "Which lists is this record on" — the record page's Lists panel.
  @@index([orgId, objectSlug, targetId])
}
