// The connection URL is NOT set here — it comes from prisma.config.ts, which
// reads the repo-root .env. That is the Prisma 7 style.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// House rules for every model in this file (CLAUDE.md → Database / Prisma):
//
//   1. EVERY model has `createdAt` and `updatedAt`. No exceptions.
//   2. NEVER use a Prisma `enum`. Use a String and document the allowed values in
//      a comment beside the field, with a matching TypeScript union in app code.
//      Postgres enums need an ALTER TYPE dance to add or remove a value; a String
//      column just changes.
//   3. Every org-scoped model carries `orgId` and is indexed on it. Reads AND
//      writes filter on it.
// -----------------------------------------------------------------------------

model Org {
  id        String   @id @default(cuid())
  name      String?
  logo      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      Membership[]
  invitations      Invitation[]
  phoneNumbers     PhoneNumber[]
  calls            Call[]
  emailDrafts      EmailDraft[]
  oauthConnections OAuthConnection[]
  mailAccounts     MailAccount[]
}

model User {
  id String @id @default(cuid())

  // The Firebase Auth uid. This is the join between the ID token on a request and
  // the row here; it is how `requireAuth` resolves a caller.
  firebaseUid String @unique

  email     String  @unique
  firstName String?
  lastName  String?
  title     String?
  imageUrl  String?

  // false blocks sign-in without deleting anything.
  enabled Boolean @default(true)

  // Global platform roles: basic, admin, superadmin. Per-org roles live in Membership.
  roles String[] @default(["basic"])

  // IANA timezone, e.g. "America/New_York". Captured at onboarding, defaulted
  // from the browser. Every time-of-day shown to this user renders in it
  // (CLAUDE.md → Dates & Times).
  timeZone String?

  // The org this user currently has selected (for UI context; not used for auth).
  // Nullable — the user may not have any org yet (edge case after account creation).
  currentOrgId String?

  memberships         Membership[]
  invitationsSent     Invitation[]      @relation("InvitationSender")
  invitationsAccepted Invitation[]      @relation("InvitationAcceptor")
  phoneNumbers        PhoneNumber[]
  calls               Call[]
  emailDrafts         EmailDraft[]
  oauthConnections    OAuthConnection[]
  mailAccounts        MailAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([currentOrgId])
}

// Join table: users can belong to multiple orgs, each with their own role set.
model Membership {
  id String @id @default(cuid())

  userId String
  orgId  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "owner", "admin", "basic". Per-org role set (different from
  // global roles). A String[] rather than an enum, per rule 2 in the schema
  // header. "owner" is never granted from the member list — ownership moves by
  // transfer — so it is absent from `assignableRolesSchema`.
  roles String[] @default(["basic"])

  // Offboarding flips this to false. The row stays so re-inviting the same person
  // reactivates it under @@unique([userId, orgId]) instead of colliding, and so a
  // departure is still visible in the record. EVERY membership read filters on it:
  // an inactive membership is the same as no membership.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([orgId, isActive])
}

// Member invitations to orgs.
model Invitation {
  id    String @id @default(cuid())
  token String @unique

  email String
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Allowed values: "PENDING", "ACCEPTED", "EXPIRED", "REVOKED"
  status String @default("PENDING")

  // Roles this invite grants (basic, admin, etc.)
  roles String[] @default(["basic"])

  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedByUser   User?     @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  invitedByUserId String?
  invitedByUser   User?   @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([email])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Dialer
//
// The dialer spec (docs/specs/SPEC-DIALER-REBUILD.md) calls the tenant key
// `workspaceId`. This schema has always called it `orgId` and points it at `Org`
// (CLAUDE.md → Database / Prisma: "Every org-scoped model carries orgId"). One
// name for one thing, so the dialer models use `orgId` too.
// -----------------------------------------------------------------------------

// A Twilio number an org owns and hands to one of its members. A user may hold
// several; at most one of theirs is the caller ID for outbound calls.
model PhoneNumber {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member this number belongs to. Restrict, not Cascade: releasing a number
  // is a Twilio call, not a row delete, so a user who still holds one cannot be
  // deleted out from under it.
  assignedUserId String
  assignedUser   User   @relation(fields: [assignedUserId], references: [id], onDelete: Restrict)

  // E.164, e.g. "+12025550123".
  e164 String

  // Twilio's SID for the number. Null until the provisioning job has actually
  // bought it — the row is written first, with status "searching".
  twilioSid String?

  // Allowed values: "searching", "active", "releasing", "failed".
  status String @default("searching")

  // At most one true per user. Enforced in the route, in a transaction.
  isActiveForOutbound Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([assignedUserId])
  @@index([e164])
}

// One call, inbound or outbound, and everything learned about it afterwards.
model Call {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The member who placed or received the call. Restrict so call history is
  // never destroyed as a side effect of deleting a user.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // E.164 both sides. fromE164 is the caller ID actually used.
  fromE164 String
  toE164   String

  // Allowed values: "outbound", "inbound".
  direction String

  // Allowed values: "queued", "ringing", "in-progress", "completed", "busy",
  // "failed", "no-answer", "canceled".
  status String @default("queued")

  // Twilio's SID for the call. Null until Twilio accepts it. Unique so the
  // status and recording webhooks can look the row up by SID alone; Postgres
  // allows many NULLs under a unique index, so queued rows do not collide.
  twilioCallSid String? @unique

  // Allowed values: "granted", "declined", or null if never asked.
  recordingConsent String?

  // True once recording actually started. Null before the call connects.
  recordingEnabled Boolean?

  // The bare S3 object KEY for the MP3 (e.g.
  // "maincar-call-recordings/{orgId}/{callId}.mp3"), written by the upload job.
  // NOT a link a browser can open: the GET-one route presigns it at request time
  // (see routes/calls.ts). Null until the recording has been uploaded.
  recordingUrl String?

  // Allowed values: "pending", "stored", "failed". Tracks the async upload of the
  // Twilio recording into S3 (jobs/uploadRecording.ts), separate from the call's
  // own lifecycle `status` above: a call can complete cleanly while its recording
  // upload is still pending or has failed, and those are not the same fact.
  recordingStatus String @default("pending")

  // Allowed values: "pending", "done", "failed", "skipped-not-recorded".
  transcriptStatus String  @default("pending")
  transcript       String?

  // Billed duration in whole seconds, from Twilio's status callback.
  durationS Int?

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([userId])
  @@index([toE164])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Email composer
//
// The dock (docs/specs/SPEC-composer-dock.md) keeps half-written emails in the
// corner of the app. One row per card.
// -----------------------------------------------------------------------------

// One half-written email. Org-scoped AND user-scoped: a draft is private to its
// author, so every read and every write filters on userId as well as orgId, and
// another member's draft is a 404 — never a 403, which would confirm it exists.
model EmailDraft {
  id String @id @default(cuid())

  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The rep writing it. Cascade: a deleted user's unsent drafts go with them.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The mailbox this will go out on. Null until composer-mailbox lands.
  // Deliberately a bare String, not a relation: MailAccount does not exist yet.
  mailAccountId String?

  // The record the composer was opened from, so reopening lands back in context.
  // Null until the CRM port lands. Also a bare String, for the same reason.
  recordId String?

  toAddrs  String[]
  ccAddrs  String[]
  bccAddrs String[]

  subject  String?
  bodyHtml String?

  // Dock state, so a refresh restores the corner exactly as the rep left it.
  //
  // Two flags, not one, because Gmail's X and its - are different acts. isOpen
  // false means the card is out of the dock but the draft is KEPT — closing an
  // email has never meant throwing it away. isMinimized means the card is still
  // in the dock, collapsed to a chip. Discarding is a DELETE, and nothing else is.
  isOpen      Boolean @default(true)
  isMinimized Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The dock's only query: this rep's drafts in this org, by last edit.
  @@index([orgId, userId, updatedAt])
}

// -----------------------------------------------------------------------------
// Integration Hub — mail/calendar OAuth
//
// The two tables the whole Integration Hub sits on
// (docs/specs/SPEC-int-schema.md § Data model). OAuthConnection holds the
// encrypted grant and the honest status; MailAccount holds the mailbox that
// grant reaches. Deleting the connection deletes the mailbox: without a token
// there is nothing left to send from.
// -----------------------------------------------------------------------------

model OAuthConnection {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // google | microsoft. A String, never a Prisma enum (rules/database-and-prisma.md).
  provider String

  // The provider's own id for this identity. Google: sub. Microsoft: oid.
  // Held so a re-consent under a changed email address still matches the row.
  providerAccountId String
  emailAddress      String

  // Encrypted at rest, format v1.<iv>.<ciphertext>.<tag>. Never logged, never
  // returned by any route, never in a response body — not even to the owner.
  refreshToken String  @db.Text
  accessToken  String? @db.Text
  expiresAt    DateTime?

  // What the provider ACTUALLY granted, not what was asked for. The difference
  // between this and REQUIRED_SCOPES is the whole amber state.
  scopes String[] @default([])

  // connected | limited | error
  status       String  @default("connected")
  // Stable code the client maps to recovery steps. Null when healthy.
  errorCode    String?
  // One line naming what does not work. Empty when healthy.
  statusDetail String?

  // When a live provider call last proved this works. Null until the first Test.
  lastValidatedAt DateTime?
  lastRefreshAt   DateTime?

  mailAccount MailAccount?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One grant per provider per rep. Reconnecting updates rather than duplicates.
  @@unique([orgId, userId, provider])
  @@index([orgId, userId])
}

model MailAccount {
  id     String @id @default(cuid())
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Deleting the grant deletes the mailbox: without a token there is nothing left
  // to send from, and a mailbox that cannot send is not a mailbox.
  connection   OAuthConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectionId String          @unique

  provider     String // duplicated from the connection so a list needs no join
  emailAddress String
  displayName  String?

  // Exactly one per (orgId, userId) is true. Moved atomically in mailAccounts.ts.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One mailbox per address per org. Re-connecting updates rather than duplicates.
  @@unique([orgId, emailAddress])
  @@index([orgId, userId])
}

// -----------------------------------------------------------------------------
// CRM — Company (MAI-129, Phase 1 / T1). The identity anchor for an account:
// groups people, deals, and the account feed.
//
// Spec: docs/specs/SPEC-CRM-SCHEMA.md (§5.15 identity anchors, §5.11 what the DB
// enforces vs. app code). Plan: tasks/plan-crm-schema.md (T1).
//
// name / legalName are NULLABLE on purpose (§5.15): a company can be created from
// just a domain seen on an email, then enriched. App code (routes/companies.ts)
// requires at least one identity ANCHOR — name, domain, or linkedinUrl — because
// "at least one of these nullable columns is non-null" is not a constraint Prisma
// can express. Display name = name ?? domain ?? "Untitled company".
//
// NOTE ON RELATIONS: this ticket ONLY adds the Company model, so there is no
// Prisma relation back to Org or User (that would require adding back-relation
// fields to those protected models). orgId and ownerUserId are plain String
// columns — the tenant boundary is enforced in the route with findFirst /
// updateMany filtered on orgId, exactly as the house rules require, and the
// @@unique([orgId, domain]) key works on the plain column. This mirrors the
// bare-String precedent EmailDraft uses for not-yet-wired references. The Person /
// Deal / Email / Meeting back-relations the full spec shows arrive with their own
// tickets (T2, T3, T9, T11).
model Company {
  id    String @id @default(cuid())
  orgId String

  // The common name you actually call them ("Google"). Nullable — see the header.
  name String?
  // The formal entity ("Alphabet Inc"), optional. Enrichment fills it.
  legalName String?

  // Business CATEGORY / model: saas | agency | manufacturer | retailer | services
  // | non_profit | ... A user-editable picklist (custom values allowed). Distinct
  // from `industry` below, which is the vertical/sector.
  companyType String?

  domain           String?
  alternateDomains String[] @default([])
  // Company LinkedIn page — an identity anchor + enrichment key.
  linkedinUrl String?

  // Vertical / sector — healthcare | finance | retail | ... Distinct from companyType.
  industry      String?
  sizeEmployees Int?
  // Enrichment-filled; the UI falls back to an initials monogram when absent.
  logoUrl String?

  mergedIntoId String? // tombstone → survivor after a merge (5.3c)
  deletedById  String? // who soft-deleted it (Trash + audit)

  parentCompanyId String?
  parentCompany   Company?  @relation("CompanyParent", fields: [parentCompanyId], references: [id], onDelete: SetNull)
  childCompanies  Company[] @relation("CompanyParent")

  ownerUserId String?

  // on_deck | on_hold | backburner | disqualified
  attentionStatus String    @default("on_deck")
  attentionReason String?
  callbackDate    DateTime?
  source          String? // manual | import | enrichment | inbound_call | ...

  customJson Json @default("{}")

  isArchived Boolean   @default(false)
  deletedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, domain]) // HubSpot's natural key. NULL domains do not collide.
  @@index([orgId])
  @@index([orgId, parentCompanyId])
  @@index([orgId, ownerUserId])
}
