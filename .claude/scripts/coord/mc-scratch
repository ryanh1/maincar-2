#!/usr/bin/env bash
# A scratch directory that belongs to YOUR worktree and nobody else's.
#
#   mc-scratch              # print the directory, creating it
#   mc-scratch probe.ts     # print a path inside it
#   eval "$(mc-scratch --env)"   # exports MC_SCRATCH and TMPDIR
#
# WHY: two sessions once wrote the same filename to /tmp. Each thought they were
# isolated, but they were running against each other's data. Per-agent ports and
# databases are defeated by a fixed scratch filename. This prevents it.
set -euo pipefail
source "$(dirname "$0")/mc-common.sh"

WT="$(mc_worktree)"
KEY="$(printf '%s' "$WT" | shasum | cut -c1-12)"
DIR="$STATE/scratch/$(basename "$WT")-$KEY"
mkdir -p "$DIR"

case "${1:-}" in
  --env)
    echo "export MC_SCRATCH=$(printf %q "$DIR")"
    echo "export TMPDIR=$(printf %q "$DIR")"
    ;;
  "") echo "$DIR" ;;
  *)  echo "$DIR/$1" ;;
esac
