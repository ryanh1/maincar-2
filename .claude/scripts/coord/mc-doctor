#!/usr/bin/env bash
# Health of the shared machine. Run it when something feels wrong.
source "$(dirname "$0")/mc-common.sh"
cd "$(mc_worktree)" 2>/dev/null || cd "$PRIMARY_CHECKOUT"
health=0

echo "=== load (check if >8 — higher means tests will fail at random) ==="; uptime
echo; echo "=== gate runners busy ==="; ls "$STATE/locks/gate" 2>/dev/null | wc -l | tr -d ' '
echo; echo "=== delivery train ==="
ready_count="$(find "$STATE/train/ready" -maxdepth 1 -name '*.tsv' -type f 2>/dev/null | wc -l | tr -d ' ')"
failed_count="$(find "$STATE/train/failed" -name failure.txt -type f 2>/dev/null | wc -l | tr -d ' ')"
echo "ready: $ready_count   failed groups: $failed_count"
if [ -d "$STATE/locks/train-conductor.lock" ]; then
  echo "conductor: HELD by pid $(cat "$STATE/locks/train-conductor.lock/pid" 2>/dev/null)"
else
  echo "conductor: free"
fi
echo; echo "=== merge lock ==="
[ -d "$STATE/locks/merge.lock" ] && echo "HELD by pid $(cat "$STATE/locks/merge.lock/pid" 2>/dev/null)" || echo free
echo; echo "=== concurrent vitest processes ==="; pgrep -fl vitest 2>/dev/null | wc -l | tr -d ' '

echo; echo "=== WORKTREES STUCK MID-MERGE OR MID-REBASE ==="
found=0
while IFS= read -r d; do
  [ -n "$d" ] || continue
  gd="$(git -C "$d" rev-parse --git-dir 2>/dev/null)" || continue
  [ -e "$gd/MERGE_HEAD" ]        && { echo "  MERGE unresolved : $d"; found=1; }
  [ -d "$gd/rebase-merge" ]      && { echo "  REBASE in progress: $d"; found=1; }
  [ -d "$gd/rebase-apply" ]      && { echo "  REBASE in progress: $d"; found=1; }
  [ -e "$gd/CHERRY_PICK_HEAD" ]  && { echo "  CHERRY-PICK stuck : $d"; found=1; }
done < <(git worktree list --porcelain | sed -n 's/^worktree //p')
[ "$found" = 0 ] && echo "  none"

echo; echo "=== PRIMARY CHECKOUT (reference only; never a ticket remote) ==="
main_tree="$PRIMARY_CHECKOUT"
if [ ! -d "$main_tree/.git" ]; then
  echo "  could not determine the primary checkout"
else
  mt_branch="$(git -C "$main_tree" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  mt_dirty="$(git -C "$main_tree" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
  echo "  path: $main_tree"
  if [ "$mt_branch" = "main" ]; then
    echo "  branch: main (ok)"
  else
    echo "  BRANCH: checked out to '$mt_branch', not main — identify its owner; do not reset or clean it"
  fi
  if [ "$mt_dirty" = "0" ]; then
    echo "  working tree: clean"
  else
    echo "  DIRTY: $mt_dirty uncommitted/untracked path(s) — identify its owner; do not reset, stash, or clean it"
  fi
  if [ "$mt_branch" = "main" ]; then
    git -C "$main_tree" fetch "$LOCAL_MAIN_REPO" --quiet main:refs/remotes/origin/main 2>/dev/null
    ahead="$(git -C "$main_tree" rev-list --count origin/main..main 2>/dev/null || echo 0)"
    behind="$(git -C "$main_tree" rev-list --count main..origin/main 2>/dev/null || echo 0)"
    if [ "$ahead" != "0" ] && [ "$behind" != "0" ]; then
      echo "  DIVERGED: local main is $ahead ahead / $behind behind origin/main — do not merge here; recover the owner’s work in an issue clone."
      health=1
    elif [ "$ahead" != "0" ]; then
      echo "  UNPUSHED: local main is $ahead commit(s) ahead of origin/main — do not push here; recover the owner’s work in an issue clone."
      health=1
    elif [ "$behind" != "0" ]; then
      echo "  REFRESH REQUIRED: local main is $behind commit(s) behind delivered main — run ./.claude/scripts/coord/mc-local-main refresh."
      health=1
    else
      echo "  in sync with origin/main"
    fi
  fi
  pending_file="$(mc_primary_refresh_pending_file)"
  if [ -f "$pending_file" ]; then
    IFS=$'\t' read -r pending_at pending_head pending_target pending_reason pending_command < "$pending_file"
    echo "  REFRESH REQUIRED since $pending_at ($pending_head → $pending_target): $pending_reason"
    echo "  Next: ${pending_command:-$(mc_primary_refresh_command)}"
    health=1
  fi
fi

echo; echo "=== LOCAL MAIN MIRROR ==="
if [ -d "$LOCAL_MAIN_REPO" ] && git -C "$LOCAL_MAIN_REPO" rev-parse --is-bare-repository >/dev/null 2>&1; then
  mirror_main="$(git -C "$LOCAL_MAIN_REPO" rev-parse --short main 2>/dev/null || echo missing)"
  echo "  $LOCAL_MAIN_REPO (bare, main: $mirror_main)"
else
  echo "  MISSING: $LOCAL_MAIN_REPO — run ./.claude/scripts/coord/mc-local-main sync"
fi

echo; echo "=== TICKET CLONES (must fetch from the local mirror) ==="
ticket_root="${MC_TICKET_ROOT:-$HOME/code/maincar-2-worktrees}"
found=0
if [ -d "$ticket_root" ]; then
  while IFS= read -r d; do
    [ -d "$d/.git" ] || continue
    found=1
    ticket_origin="$(git -C "$d" remote get-url origin 2>/dev/null || echo missing)"
    if [ "$ticket_origin" = "$LOCAL_MAIN_REPO" ]; then
      echo "  ok: $d"
    else
      echo "  LEGACY ORIGIN: $d → $ticket_origin (expected $LOCAL_MAIN_REPO; mc-train enqueue will migrate it)"
    fi
  done < <(find "$ticket_root" -mindepth 1 -maxdepth 1 -type d -print 2>/dev/null)
fi
[ "$found" = 0 ] && echo "  none"

echo; echo "=== ORPHANED WORKTREES (commits not on origin/main) ==="
# Sub-agent waves (Agent tool isolation:"worktree", or /linear-execute-project)
# land under .claude/worktrees/*. A wave that never got "landed" leaves one of
# these behind indefinitely — fully coded, tested, and reviewed, but not
# merged, not pushed, and easy to mistake for still-active work. This differs
# from the mid-merge check above: that one catches a merge caught mid-flight,
# this one catches a merge that never started at all.
git fetch origin --quiet 2>/dev/null
found=0
while IFS= read -r d; do
  [ -n "$d" ] || continue
  [ "$d" = "$(mc_worktree)" ] && continue
  case "$d" in */.claude/worktrees/*) ;; *) continue ;; esac
  br="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)" || continue
  [ "$br" = "HEAD" ] && continue  # detached, not a branch to track
  sha="$(git -C "$d" rev-parse HEAD 2>/dev/null)" || continue
  if ! git -C "$d" merge-base --is-ancestor "$sha" origin/main 2>/dev/null; then
    dirty="$(git -C "$d" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
    echo "  $d  (branch: $br, dirty files: $dirty) — NOT on origin/main"
    found=1
  fi
done < <(git worktree list --porcelain | sed -n 's/^worktree //p')
[ "$found" = 0 ] && echo "  none — every worktree's commits are on origin/main"

echo; echo "=== firebase emulators ==="
pgrep -f 'firebase.*emulators:start' 2>/dev/null | while read -r p; do
  ports=$(lsof -nP -p "$p" -iTCP -sTCP:LISTEN 2>/dev/null | awk '{print $9}' | sed 's/.*://' | sort -n | tr '\n' ' ')
  echo "  pid $p  ports: $ports"
done
[ -z "$(pgrep -f 'firebase.*emulators:start' 2>/dev/null)" ] && echo "  none running"

echo; echo "=== docker ==="; docker ps --format '{{.Names}}\t{{.Status}}' 2>&1 | grep maincar2 || echo "  (maincar2 containers not found)"
echo; echo "=== postgres ==="; docker exec maincar2-postgres pg_isready -U postgres 2>&1 | head -1 || echo "  (container not running)"
echo -n "  connections in use: "; docker exec maincar2-postgres psql -U postgres -tAc "select count(*)||'/'||current_setting('max_connections') from pg_stat_activity" 2>&1 || echo "  (failed)"
echo -n "  leftover test databases: "; docker exec maincar2-postgres psql -U postgres -tAc "select count(*) from pg_database where datname like 'maincar2_authoring_%'" 2>&1 || echo "  (failed)"

echo; echo "=== duplicate migration timestamps (never renumber; write a new one) ==="
dupes=$(ls server/prisma/migrations 2>/dev/null | sed -n 's#^\([0-9]\{14\}\)_.*#\1#p' | sort | uniq -d)
[ -n "$dupes" ] && echo "$dupes" || echo "  none on this branch"

exit "$health"
