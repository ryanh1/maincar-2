#!/usr/bin/env bash
# Delivers YOUR already-verified branch to main, one short critical section at a
# time. Full tests belong to mc-gate --delivery, outside this global merge lock.
#
#   mc-merge -m "MAI-123: descriptive merge subject"
#   mc-merge --gate -m "MAI-123: ..."  # accepted for old callers; does not test
#   mc-merge --check                   # is the current receipt mergeable?
set -euo pipefail
source "$(dirname "$0")/mc-common.sh"

MSG=""
LEGACY_GATE=0
while :; do
  case "${1:-}" in
    -m) MSG="${2:-}"; shift 2 ;;
    --gate) LEGACY_GATE=1; shift ;;
    *) break ;;
  esac
done

WT="$(mc_worktree)"
BR="$(mc_branch)"
cd "$WT"
mc_assert_ticket_checkout || exit 2
[ "$BR" = "main" ] && { echo "mc-merge: you are on main. Run this from your ticket branch." >&2; exit 2; }
if [ -n "$(git status --porcelain)" ]; then
  echo "mc-merge: working tree is dirty. Commit or stash first." >&2
  git status --short >&2
  exit 2
fi
if [ "$LEGACY_GATE" = 1 ]; then
  echo "[mc-merge] --gate is retained for compatibility; it no longer runs tests under the merge lock." >&2
fi

UPSTREAM="$(mc_canonical_upstream_url)" || exit 1
mc_fetch_local_main --quiet
HEAD="$(git rev-parse HEAD)"
TIP="$(git rev-parse origin/main)"
BASE="$(git merge-base HEAD origin/main)"

if [ "$BASE" != "$TIP" ]; then
  echo "mc-merge: branch is $(git rev-list --count "$BASE..$TIP") commit(s) behind origin/main." >&2
  echo "  Run: git rebase origin/main && ./.claude/scripts/coord/mc-gate --delivery" >&2
  exit 1
fi

if [ "${1:-}" = "--check" ]; then
  mc_require_delivery_receipt "$HEAD" "$TIP" "$BR"
  echo "delivery receipt is current for $(git rev-parse --short "$HEAD") on $(git rev-parse --short "$TIP")"
  exit 0
fi

mc_require_delivery_receipt "$HEAD" "$TIP" "$BR" || exit 1

LOCK="$STATE/locks/merge.lock"
echo "[mc-merge] delivery receipt is current; waiting for the short merge lock..."
mc_lock_acquire "$LOCK" 1800 || { echo "mc-merge: merge lock busy for 30 min. Tell the coordinator." >&2; exit 1; }
TMP=""
cleanup() {
  [ -n "$TMP" ] && git worktree remove --force "$TMP" 2>/dev/null || true
  mc_lock_release "$LOCK"
}
trap cleanup EXIT
echo "[mc-merge] lock held. Rechecking the delivery receipt before merging $BR."
mc_log "merge start $BR"

# The lock closes the time-of-check/time-of-use gap. It is intentionally the
# only point at which a waiting merge can invalidate another ticket's receipt.
mc_fetch_local_main --quiet
CURRENT_HEAD="$(git rev-parse HEAD)"
CURRENT_TIP="$(git rev-parse origin/main)"
if ! mc_require_delivery_receipt "$CURRENT_HEAD" "$CURRENT_TIP" "$BR"; then
  echo "  main changed while you waited; rebase and rerun the delivery gate outside the lock." >&2
  mc_log "merge aborted $BR (delivery receipt stale after lock)"
  exit 1
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/mc-merge-XXXXXX")"
rm -rf "$TMP"
git worktree add --detach "$TMP" origin/main --quiet
[ -z "$MSG" ] && MSG="Merge $BR into main"
printf '%s\n\nCo-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>\n' "$MSG" > "$TMP/../mc-merge-msg.txt"
git -C "$TMP" merge --no-ff "$BR" -F "$TMP/../mc-merge-msg.txt"
git -C "$TMP" push "$UPSTREAM" HEAD:main
git worktree remove --force "$TMP" 2>/dev/null || true
TMP=""
mc_lock_release "$LOCK"
trap - EXIT

# The push is durable; mirror refresh and primary-checkout hygiene should not
# prevent another already-verified ticket from entering the next short merge.
mc_sync_local_main
mc_refresh_primary_checkout
git fetch --quiet origin
mc_record_delivery "$BR" "$(git -C "$LOCAL_MAIN_REPO" rev-parse main)" "$UPSTREAM"
echo "[mc-merge] merged and pushed. $BR is on main."
mc_log "merge done $BR"
