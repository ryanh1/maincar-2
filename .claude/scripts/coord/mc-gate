#!/usr/bin/env bash
# Shares a small number of check slots across every issue clone. A focused
# check gets one Vitest worker; static, final, and delivery checks get two.
set -euo pipefail
source "$(dirname "$0")/mc-common.sh"
mc_assert_ticket_checkout || exit 2

CLASS=""
PRIORITY=1
VITEST_WORKERS=1
FOCUSED_WORKSPACE=""
FOCUSED_PATH=""
TESTS=("")

valid_test_spec() {
  local spec="$1" kind path
  case "$spec" in *,*|*$'\t'*|*$'\n'*|*$'\r'*|*$'\037'*) return 1 ;; esac
  kind="${spec%%:*}"
  path="${spec#*:}"
  [ "$path" != "$spec" ] || return 1
  [[ "$path" != /* && "$path" != *..* ]] || return 1
  case "$kind" in
    server|vite) [[ "$path" = *.test.* || "$path" = *.spec.* ]] ;;
    integration) [[ "$path" = *.integration.test.* ]] ;;
    shell) [[ "$path" = *.sh ]] ;;
    *) return 1 ;;
  esac
}

parse_named_tests() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --test)
        valid_test_spec "${2:-}" || {
          echo '[mc-gate] tests must use server:path.test.*, vite:path.test.*, integration:path.integration.test.*, or shell:path.sh.' >&2
          exit 2
        }
        TESTS+=("$2")
        shift 2
        ;;
      *) echo "[mc-gate] unknown $CLASS option: $1" >&2; exit 2 ;;
    esac
  done
}

case "${1:-}" in
  --focused)
    CLASS=focused
    PRIORITY=1
    VITEST_WORKERS=1
    shift
    if [ "${1:-}" != -- ]; then
      echo "[mc-gate] focused checks require '--' before the approved test command." >&2
      exit 2
    fi
    shift
    if [ "$#" -ne 7 ] || [ "$1" != npm ] || [ "$2" != --prefix ] || { [ "$3" != server ] && [ "$3" != vite ]; } || [ "$4" != exec ] || [ "$5" != vitest ] || [ "$6" != run ] || [[ "$7" != *.test.* && "$7" != *.spec.* ]] || [[ "$7" = /* || "$7" = *..* ]]; then
      echo '[mc-gate] focused checks must name one Vitest file with: npm --prefix <server|vite> exec vitest run <file>.' >&2
      exit 2
    fi
    FOCUSED_WORKSPACE="$3"
    FOCUSED_PATH="$7"
    ;;
  --static)
    CLASS=static
    PRIORITY=2
    VITEST_WORKERS=2
    shift
    [ "$#" -eq 0 ] || { echo '[mc-gate] static checks do not accept options.' >&2; exit 2; }
    ;;
  --check)
    CLASS=check
    PRIORITY=2
    VITEST_WORKERS=2
    shift
    parse_named_tests "$@"
    ;;
  --delivery)
    CLASS=delivery
    PRIORITY=3
    VITEST_WORKERS=2
    shift
    parse_named_tests "$@"
    ;;
  *)
    echo '[mc-gate] choose --focused, --static, --check, or --delivery.' >&2
    exit 2
    ;;
esac

JOB_LIMIT=3
SEM="$STATE/locks/gate"
mkdir -p "$SEM"
WAIT_DIR="$SEM/wait-$PRIORITY-$(date +%s)-$$"
SLOT_DIR=""
mkdir "$WAIT_DIR"
printf '%s\n' "$$" > "$WAIT_DIR/pid"

cleanup() {
  [ -z "$SLOT_DIR" ] || rm -rf "$SLOT_DIR"
  rm -rf "$WAIT_DIR"
}
trap cleanup EXIT

reap_dead() {
  local dir owner
  for dir in "$SEM"/slot-* "$SEM"/wait-*; do
    [ -d "$dir" ] || continue
    owner="$(cat "$dir/pid" 2>/dev/null || true)"
    if [ -z "$owner" ] || ! kill -0 "$owner" 2>/dev/null; then rm -rf "$dir"; fi
  done
}

active_jobs() {
  local count=0 dir
  for dir in "$SEM"/slot-*; do [ -d "$dir" ] && count=$((count + 1)); done
  printf '%s\n' "$count"
}

first_waiter() {
  local priority dir
  for priority in 3 2 1; do
    dir="$(find "$SEM" -maxdepth 1 -type d -name "wait-$priority-*" -print 2>/dev/null | sort | head -1)"
    if [ -n "$dir" ]; then printf '%s\n' "$dir"; return; fi
  done
}

acquire() {
  local waited=0 first count
  while [ "$waited" -lt 3600 ]; do
    if mc_lock_acquire "$SEM/admission.lock" 15; then
      reap_dead
      first="$(first_waiter)"
      count="$(active_jobs)"
      if [ "$first" = "$WAIT_DIR" ] && [ "$count" -lt "$JOB_LIMIT" ]; then
        SLOT_DIR="$SEM/slot-$$"
        mkdir "$SLOT_DIR"
        printf '%s\n' "$$" > "$SLOT_DIR/pid"
        printf '%s\n' "$CLASS" > "$SLOT_DIR/class"
        printf '%s\n' "$VITEST_WORKERS" > "$SLOT_DIR/workers"
        rm -rf "$WAIT_DIR"
        mc_lock_release "$SEM/admission.lock"
        return 0
      fi
      mc_lock_release "$SEM/admission.lock"
    fi
    if [ "$waited" -eq 0 ]; then echo "[mc-gate] $CLASS lane is at capacity — queued (limit $JOB_LIMIT)."; fi
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

acquire || { echo '[mc-gate] waited an hour for a check slot.' >&2; exit 1; }
echo "[mc-gate] running (class $CLASS, slot $(basename "$SLOT_DIR"), limit $JOB_LIMIT, vitest=$VITEST_WORKERS)"
mc_log "gate acquire $(basename "$SLOT_DIR") class=$CLASS workers=$VITEST_WORKERS"
cd "$(mc_worktree)"

if ! mc_ensure_prisma_client; then
  echo '[mc-gate] Could not bring the Prisma client in sync.' >&2
  mc_log 'gate refused (prisma client regenerate failed)'
  exit 3
fi

record_check() {
  [ -z "${MC_GATE_TEST_LOG:-}" ] || printf '%s\t%s\n' "$CLASS" "$*" >> "$MC_GATE_TEST_LOG"
}

run_check() {
  record_check "$*"
  VITEST_MAX_WORKERS="$VITEST_WORKERS" "$@"
}

run_workspace_vitest() {
  local workspace="$1" path="$2"
  record_check "npm --prefix $workspace exec vitest run $path"
  (cd "$workspace" && VITEST_MAX_WORKERS="$VITEST_WORKERS" npm exec vitest run "$path")
}

run_named_test() {
  local spec="$1" kind path
  kind="${spec%%:*}"
  path="${spec#*:}"
  case "$kind" in
    server|vite) run_workspace_vitest "$kind" "$path" ;;
    integration)
      record_check "npm --prefix server exec vitest run --config vitest.integration.config.ts $path"
      (cd server && VITEST_MAX_WORKERS="$VITEST_WORKERS" npm exec vitest run --config vitest.integration.config.ts "$path")
      ;;
    shell)
      record_check "bash $path"
      bash "$path"
      ;;
  esac
}

run_static() {
  run_check npm run typecheck
  run_check npm run lint
}

set +e
if [ "$CLASS" = focused ]; then
  run_workspace_vitest "$FOCUSED_WORKSPACE" "$FOCUSED_PATH"
  rc=$?
else
  run_static
  rc=$?
  if [ "$rc" -eq 0 ] && [ "$CLASS" != static ]; then
    for spec in "${TESTS[@]}"; do
      [ -n "$spec" ] || continue
      run_named_test "$spec" || { rc=$?; break; }
    done
  fi
fi
set -e

mc_log "gate release rc=$rc"
if [ "$rc" -ne 0 ]; then
  echo "[mc-gate] FAILED rc=$rc — fix this issue and run the same named check again." >&2
fi
exit "$rc"
