# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# One .env at the repo root serves both packages: the server loads it directly,
# and Vite reads it via `envDir: '..'` (only VITE_-prefixed vars reach the browser).

# --- Postgres (Docker Compose, docker/docker-compose.yml) ---
# Host port 5440 is this project's alone. Other local stacks own 5432/5433/5434/5435.
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/maincar2?schema=public
# Direct (non-pooled) connection. Locally it is the same URL; against a pooled
# provider (Neon/Supabase pgbouncer) this must be the direct endpoint, because
# `prisma migrate` cannot run through a transaction pooler.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5440/maincar2?schema=public

# --- API service ---
API_PORT=3010
WEB_ORIGIN=http://localhost:5183
LOG_LEVEL=debug
NODE_ENV=development
# Public URL the API is reachable on from the internet (the zrok tunnel).
# Reserve it once:  zrok reserve public localhost:3010 --unique-name maincar2-api
# Then `npm run tunnel` shares it. Webhook callback URLs are built from this.
PUBLIC_BASE_URL=https://maincar2-api.share.zrok.io

# --- MinIO / S3 (local dev = MinIO; prod = real S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=maincar2-local

# --- Token encryption (server — SECRET. Never VITE_-prefixed, never committed) ---
# Master key for AES-256-GCM encryption of OAuth refresh tokens at rest. base64
# for 32 raw bytes. Generate with:  openssl rand -base64 32
# The server refuses to start if this is missing or does not decode to 32 bytes.
TOKEN_ENC_KEY=generate_with_openssl_rand_base64_32

# HMAC-SHA256 key that signs the stateless OAuth `state` (CSRF + who-consented)
# carried through the consent round-trip. Separate from TOKEN_ENC_KEY on purpose:
# rotating one never touches the other. Must be at least 32 characters — the
# server refuses to start under that. Generate with:  openssl rand -base64 32
OAUTH_STATE_SECRET=generate_with_openssl_rand_base64_32

# --- OAuth provider apps (server — SECRET. Never VITE_-prefixed, never committed) ---
# One shared OAuth app per provider serves every org. The server refuses to start if
# any of these is missing (config.ts reads them with no fallback), so a placeholder
# lets it boot while only a live consent fails until real credentials are provisioned.
#
# Google: create an OAuth client in the Google Cloud console (APIs & Services →
# Credentials), type "Web application", and register the redirect URI
#   ${OAUTH_REDIRECT_BASE}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
# Microsoft: register an app in Entra (Azure AD) → App registrations, expose it to
# the `organizations` tenant (work/school accounts), add a client secret, and register
#   ${OAUTH_REDIRECT_BASE}/api/integrations/microsoft/callback
MS_OAUTH_CLIENT_ID=your_microsoft_application_client_id
MS_OAUTH_CLIENT_SECRET=your_microsoft_client_secret
# The public origin the provider redirects back to. Every provider's redirect_uri is
# built from it, so it must match — character for character — a redirect URI registered
# on the OAuth app. Locally this is the zrok tunnel; a trailing slash is trimmed.
OAUTH_REDIRECT_BASE=https://maincar2-api.share.zrok.io

# --- Firebase (client — public config, VITE_-prefixed so the SPA can read it) ---
VITE_API_URL=http://localhost:3010
# "local" | "staging" | "production". "local" wires the SPA to the emulators.
VITE_ENVIRONMENT=local
# The WHOLE Firebase web config as one JSON string, so adding a field never means
# adding another env var. Copy the config object out of the Firebase console.
# Any placeholder works against the emulator — it never checks the API key.
VITE_FIREBASE_CONFIG={"apiKey":"local-emulator","authDomain":"maincar-2.firebaseapp.com","projectId":"maincar-2","storageBucket":"maincar-2.firebasestorage.app","messagingSenderId":"000000000000","appId":"1:000000000000:web:000000000000"}
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9140
# Set to "true" to silence the per-request [API] console logging.
# VITE_DISABLE_API_LOGGING=false

# --- Firebase Admin (server — SECRET. Never VITE_-prefixed, never committed) ---
FIREBASE_PROJECT_ID=maincar-2
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_WITH_ESCAPED_NEWLINES\n-----END PRIVATE KEY-----\n"
# Local dev only — points the Admin SDK at the Auth emulator. Leave unset in production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9140

# --- Twilio (server — SECRET. Never VITE_-prefixed, never committed) ---
# From console.twilio.com. Leave blank and the server still boots; only the
# routes that call Twilio fail, and they say which var is missing.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Browser calling (the Voice SDK access token — dependencies/twilio.ts →
# mintVoiceAccessToken). An API Key is a SEPARATE credential from the auth token
# above; create one at console.twilio.com/us1/account/keys-credentials/api-keys.
# TWILIO_TWIML_APP_SID is a TwiML Application whose Voice Request URL is
# PUBLIC_BASE_URL + /api/twilio/voice (same URL a purchased number's inbound
# calls point at). Leave blank and the server still boots; only a rep pressing
# Call fails, and it says which var is missing.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (server — SECRET. Never VITE_-prefixed, never committed) ---
# From platform.openai.com. Used only to transcribe call recordings (Whisper).
# Leave blank and the server still boots; only the transcription job fails, and it
# says which var is missing.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
